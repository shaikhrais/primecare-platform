FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_HOME=/opt/flutter
ENV PATH=${PATH}:${FLUTTER_HOME}/bin

# Install core build dependencies for Flutter Linux Desktop
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libstdc++-12-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone Flutter stable
RUN git clone https://github.com/flutter/flutter.git -b stable ${FLUTTER_HOME}

# Pre-cache Flutter artifacts
RUN flutter doctor
RUN flutter config --enable-linux-desktop

WORKDIR /workspace

# Copy the monorepo into the container
COPY . .

# Build script inside container
CMD ["bash", "-c", "for app in apps/*; do if [ -d \"$app\" ]; then cd \"$app\"; flutter pub get; flutter build linux --release; cd ../..; fi; done"]
