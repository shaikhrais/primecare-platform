  "contracts": [
    {
      "method": "GET",
      "suffix": "",
      "request": {
        "type": "object",
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "required": [
          "canManage",
          "source",
          "summary",
          "territories",
          "tenants"
        ],
        "properties": {
          "canManage": {
            "type": "boolean"
          },
          "source": {
            "type": "object"
          },
          "territories": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "id",
                "number",
                "code",
                "name",
                "status",
                "seniors65",
                "population",
                "fsas",
                "canSell",
                "version",
                "allocation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "available",
                    "sold",
                    "reserve"
                  ]
                },
                "seniors65": {
                  "type": "integer",
                  "minimum": 0
                },
                "population": {
                  "type": "integer"
                },
                "fsas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "canSell": {
                  "type": "boolean"
                },
                "version": {
                  "enum": [
                    0,
                    1
                  ]
                },
                "allocation": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "tenantId": {
                      "type": "string"
                    },
                    "tenantName": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "psw",
                          "home_care"
                        ]
                      }
                    },
                    "recordedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "available": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "seniors65": {
                    "type": "integer"
                  }
                }
              },
              "sold": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "seniors65": {
                    "type": "integer"
                  }
                }
              },
              "reserve": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "seniors65": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "method": "POST",
      "suffix": "/{id}/sale",
      "request": {
        "type": "object",
        "required": [
          "version",
          "tenantId",
          "services",
          "reference",
          "confirmed"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "const": 0
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "psw",
                "home_care"
              ]
            }
          },
          "reference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "confirmed": {
            "const": true
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "territoryId",
          "status",
          "version"
        ],
        "properties": {
          "territoryId": {
            "type": "string"
          },
          "status": {
            "const": "sold"
          },
          "version": {
            "const": 1
          }
        }
      }
    }
  ],
