  "request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "search": {
        "type": "string",
        "maxLength": 100
      },
      "filter": {
        "enum": [
          "all",
          "attention",
          "active",
          "inactive"
        ]
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "scope",
      "tenants",
      "summary",
      "pagination",
      "source"
    ],
    "properties": {
      "scope": {
        "enum": [
          "global",
          "own"
        ]
      },
      "source": {
        "type": "object"
      },
      "tenants": {
        "type": "array",
        "maxItems": 25,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "slug",
            "status",
            "counts",
            "checks",
            "issues",
            "actions"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "status": {
              "enum": [
                "active",
                "inactive",
                "unknown"
              ]
            },
            "counts": {
              "type": "object",
              "properties": {
                "accounts": {
                  "type": "integer",
                  "minimum": 0
                },
                "administrators": {
                  "type": "integer",
                  "minimum": 0
                },
                "locations": {
                  "type": "integer",
                  "minimum": 0
                },
                "categories": {
                  "type": "integer",
                  "minimum": 0
                },
                "territories": {
                  "type": "integer",
                  "minimum": 0
                },
                "seniors65": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "enum": [
                  "accounts",
                  "masters",
                  "territories"
                ]
              }
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "integer",
            "minimum": 0
          },
          "inactive": {
            "type": "integer",
            "minimum": 0
          },
          "attention": {
            "type": "integer",
            "minimum": 0
          },
          "territories": {
            "type": "integer",
            "minimum": 0
          },
          "seniors65": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "pagination": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "const": 25
          },
          "total": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
