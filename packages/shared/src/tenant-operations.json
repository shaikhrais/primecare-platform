    {
      "key": "location",
      "count": "locations",
      "minimum": 1,
      "issue": "missing_location",
      "view": "masters",
      "labelKey": "setup_location"
    },
    {
      "key": "category",
      "count": "categories",
      "minimum": 1,
      "issue": "missing_category",
      "view": "masters",
      "labelKey": "setup_category"
    }
  ],
  "destinations": [
    "accounts",
    "masters",
    "territories"
