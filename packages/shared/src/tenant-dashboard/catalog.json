  "shortcuts": [
    {
      "id": "accounts",
      "label": "Accounts & roles",
      "description": "Create and update permitted tenant accounts using the existing administration workflow.",
      "route": "/platform/administration#accounts",
      "category": "people",
      "status": "Connected module"
    },
    {
      "id": "care",
      "label": "Schedule & care team",
      "description": "Named providers, assignments, availability and existing clinical review rules.",
      "route": "/care?dataset=live",
      "category": "operations",
      "status": "Connected module"
    },
    {
      "id": "requests",
      "label": "PSW requests",
      "description": "Review saved work requests and respond to staff.",
      "route": "/psw-requests",
      "category": "operations",
      "status": "Connected module"
    },
    {
      "id": "charge",
      "label": "Coordinator additional charge",
      "description": "Assign coordinator responsibility without merging the Tenant Admin role.",
      "route": "/coordinator-charge",
      "category": "operations",
      "status": "Connected module"
    },
    {
      "id": "plans",
      "label": "Six-month growth plans",
      "description": "Choose a template, allocate owners and track evidence in the business planning module.",
      "route": "/business-plans",
      "category": "growth",
      "status": "Connected module"
    },
    {
      "id": "marketing",
      "label": "Marketing & acquisition",
      "description": "Open the existing growth workspace for the permissions granted to this account.",
      "route": "/growth",
      "category": "growth",
      "status": "Permission checked by module"
    },
    {
      "id": "reports",
      "label": "Reports & administration",
      "description": "Open existing tenant administration and reporting controls.",
      "route": "/platform/administration#reports",
      "category": "audit",
      "status": "Permission checked by module"
    },
    {
      "id": "account",
      "label": "My account & security",
      "description": "Password, phone status and account security.",
      "route": "/success",
      "category": "people",
      "status": "Connected module"
    }
  ],
