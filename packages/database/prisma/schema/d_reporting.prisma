// Domain: d_reporting.prisma

// 
model FacilityNode {
  id           String   @id @default(uuid())
  tenantId     String
  facilityName String
  location     String
  managerName  String
  status       String // Operational, Review, Issue
  satisfaction Float
  dailyVisits  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model StaffUtilization {
  id            String   @id @default(uuid())
  tenantId      String
  staffName     String
  role          String
  totalHours    Float
  clinicalHours Float
  adminHours    Float
  status        String // Optimized, Overworked, Underutilized
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model OpsIssueTicket {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String
  facilityName String
  severity     String // Critical, High, Medium, Low
  status       String // Reported, Dispatched, Resolved
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

// 
model SalesDealNode {
  id             String   @id @default(uuid())
  tenantId       String
  dealName       String
  facilityTarget String
  amount         Float
  stage          String // Discovery, Evaluation, Proposal, Closed Won
  repName        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model KeyAccountNode {
  id             String   @id @default(uuid())
  tenantId       String
  accountName    String
  contactName    String
  stage          String
  potentialValue Float
  probability    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model RepPerformanceNode {
  id            String   @id @default(uuid())
  tenantId      String
  repName       String
  quota         Float
  attainment    Float
  meetings      Int
  pipelineValue Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// 
model MarketingCampaignNode {
  id           String   @id @default(uuid())
  tenantId     String
  campaignName String
  platform     String // Google Ads, Social, Email
  spend        Float
  revenue      Float
  leads        Int
  status       String // Active, Paused, Completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model LocalGrowthNode {
  id             String   @id @default(uuid())
  tenantId       String
  regionName     String
  patientAcqCost Float
  newPatients    Int
  totalRevenue   Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model ContentAssetNode {
  id           String   @id @default(uuid())
  tenantId     String
  assetName    String
  assetType    String // Banner, Email, Print
  author       String
  status       String // Draft, Review, Live
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}
