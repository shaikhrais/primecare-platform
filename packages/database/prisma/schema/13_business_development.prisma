model BdmLead {
  id                String   @id @default(uuid()) @db.Uuid
  title             String
  company           String
  status            String   @default("NEW") // NEW, CONTACTED, MEETING_SCHEDULED, PROPOSAL_SENT, CLOSED_WON, CLOSED_LOST
  contactName       String
  contactEmail      String
  contactPhone      String?
  territory         String
  expectedValue     Float?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assignedToUserId  String   @db.Uuid

  @@index([status])
  @@index([assignedToUserId])
  @@index([territory])
}

model TerritoryExpansionPlan {
  id                String   @id @default(uuid()) @db.Uuid
  regionName        String
  targetDate        DateTime
  status            String   @default("PLANNING") // PLANNING, RESEARCHING, ACTIVE_OUTREACH, LAUNCHED
  budget            Float
  demographicNotes  String?  @db.Text
  competitorNotes   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([regionName])
}

model PartnershipDeal {
  id                String   @id @default(uuid()) @db.Uuid
  partnerName       String
  partnerType       String   @default("VENDOR") // VENDOR, INTEGRATION, STRATEGIC, MARKETING
  status            String   @default("NEGOTIATING") // PROSPECT, NEGOTIATING, ACTIVE, EXPIRED
  startDate         DateTime?
  endDate           DateTime?
  dealValue         Float?
  terms             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  managedByUserId   String   @db.Uuid

  @@index([status])
  @@index([partnerType])
}
