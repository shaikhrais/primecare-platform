// Domain: d_support.prisma

// 
model SupportTicketNode {
  id            String   @id @default(uuid())
  tenantId      String
  franchiseName String
  patientRef    String
  issueType     String
  status        String
  assignedTo    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model PatientFeedbackNode {
  id            String   @id @default(uuid())
  tenantId      String
  patientName   String
  franchiseName String
  rating        Int // 1 to 5
  comments      String
  status        String // Reviewed, Pending
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model SystemTelemetryNode {
  id            String   @id @default(uuid())
  tenantId      String
  serviceName   String // DB Edge, API Gateway, Worker
  uptimePercent Float
  latencyMs     Int
  status        String // Operational, Degraded, Down
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// 
model SupportAgentNode {
  id            String   @id @default(uuid())
  tenantId      String
  agentName     String
  shiftTime     String
  activeTickets Int
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model TicketVolumeNode {
  id            String   @id @default(uuid())
  tenantId      String
  hourlyMark    String
  inboundCount  Int
  resolvedCount Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model ResolutionFeedbackNode {
  id           String   @id @default(uuid())
  tenantId     String
  patientName  String
  csatScore    Float
  feedbackText String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}
