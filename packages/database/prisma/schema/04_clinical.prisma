// ==========================================
// CLINICAL OPERATIONS MODELS
// ==========================================

model CarePlan {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  tenantId      String    @map("tenant_id")
  diagnoses     String
  clinicalGoals String?   @map("clinical_goals")
  interventions String?   @map("interventions")
  status        String    @default("active") // active, completed, archived
  reviewDate    DateTime? @map("review_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  // RN Mastery Extensions
  authorId     String? @map("author_id")
  version      Int     @default(1)
  isArchived   Boolean @default(false) @map("is_archived")
  outcomeNotes String? @map("outcome_notes")
  author       User?   @relation("CarePlanAuthor", fields: [authorId], references: [id])

  @@index([tenantId])
  @@map("care_plans")
}

model ClinicalRecord {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  type      String // e.g., 'Observation', 'Condition', 'Medication'
  data      String   @map("data_json") // FHIR-compliant structure
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([clientId])
  @@index([tenantId])
  @@map("clinical_records")
}

model ClinicalAssessment {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  rnId            String   @map("rn_id")
  tenantId        String   @map("tenant_id")
  type            String // ADL, MOBILITY, COGNITIVE, etc.
  assessmentData  Json     @map("assessment_data")
  score           Int?
  recommendations String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  rn     User          @relation(fields: [rnId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("clinical_assessments")
}

model MedicationRecon {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  rnId          String   @map("rn_id")
  tenantId      String   @map("tenant_id")
  reconData     Json     @map("recon_data")
  discrepancies String?
  status        String   @default("completed") // completed, pending_review
  createdAt     DateTime @default(now()) @map("created_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  rn     User          @relation(fields: [rnId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("medication_reconciliations")
}

model SupervisionLog {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  rnId           String   @map("rn_id")
  tenantId       String   @map("tenant_id")
  competencies   String
  isSatisfactory Boolean  @default(true) @map("is_satisfactory")
  feedback       String?
  createdAt      DateTime @default(now()) @map("created_at")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  rn     User            @relation(fields: [rnId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("supervision_logs")
}

model HealthID {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  did       String   @unique // W3C Decentralized Identifier
  publicKey String   @map("public_key")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("health_ids")
}

model FhirSyncLog {
  id           String   @id @default(uuid())
  direction    String // INBOUND, OUTBOUND
  resourceType String   @map("resource_type")
  externalId   String?  @map("external_id")
  status       String // SUCCESS, FAILURE
  error        String?
  timestamp    DateTime @default(now())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("fhir_sync_logs")
}

model VitalSign {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  type       String // HEART_RATE, BLOOD_PRESSURE, OXYGEN_SAT, TEMPERATURE
  value      Float
  unit       String
  source     String   @default("MANUAL") // MANUAL, WEARABLE, DEVICE
  recordedAt DateTime @default(now()) @map("recorded_at")

  patient ClientProfile @relation(fields: [patientId], references: [id])

  @@map("vital_signs")
}

model PatientAlert {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  patientId String   @map("patient_id")
  type      String // CLINICAL, OPERATIONAL, TECHNICAL
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message   String
  status    String   @default("open") // open, acknowledged, resolved
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient ClientProfile @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("patient_alerts")
}

model Medication {
  id           String   @id @default(uuid())
  name         String
  genericName  String?  @map("generic_name")
  dosageForm   String?  @map("dosage_form") // Tablet, Injection, etc.
  strength     String?
  instructions String?
  createdAt    DateTime @default(now()) @map("created_at")

  prescriptions Prescription[]

  @@map("medications")
}

model Prescription {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  patientId    String    @map("patient_id")
  medicationId String    @map("medication_id")
  prescriberId String?   @map("prescriber_id")
  dosage       String
  frequency    String
  route        String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("active") // active, completed, discontinued
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  patient    ClientProfile @relation(fields: [patientId], references: [id])
  medication Medication    @relation(fields: [medicationId], references: [id])
  marEntries MAR_Entry[]

  @@index([tenantId])
  @@map("prescriptions")
}

model MAR_Entry {
  id               String    @id @default(uuid())
  patientId        String?   @map("patient_id")
  clientId         String?   @map("client_id")
  prescriptionId   String?   @map("prescription_id")
  administerId     String?   @map("administer_id") // User ID (PSW, RN)
  administeredById String?   @map("administered_by_id")
  adminTime        DateTime  @default(now()) @map("admin_time")
  scheduledTime    DateTime? @map("scheduled_time")
  administeredAt   DateTime? @map("administered_at")
  status           String    @default("administered") // administered, missed, refused, given, held, not_available
  notes            String?
  medicationName   String?   @map("medication_name")
  dosage           String?
  route            String?
  tenantId         String?   @map("tenant_id")

  patient      ClientProfile? @relation(fields: [patientId], references: [id])
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id])

  @@index([clientId])
  @@index([tenantId])
  @@map("mar_entries")
}

model EVVRecord {
  id                 String   @id @default(uuid())
  visitId            String   @map("visit_id")
  providerId         String   @map("provider_id")
  checkType          String   @map("check_type") // check_in, check_out
  lat                Float?
  lng                Float?
  accuracy           Float?
  verificationMethod String   @default("gps") @map("verification_method") // gps, pin, biometric
  status             String   @default("valid") // valid, exception, overridden
  overrideById       String?  @map("override_by_id")
  overrideReason     String?  @map("override_reason")
  rawData            String?  @map("raw_data")
  capturedAt         DateTime @default(now()) @map("captured_at")
  tenantId           String   @map("tenant_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([visitId])
  @@index([providerId])
  @@map("evv_records")
}

model ServiceAuthorization {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  serviceId       String?  @map("service_id")
  fundingSource   String   @map("funding_source") // ohip, private, insurance, lhin
  authorizedHours Float    @map("authorized_hours")
  usedHours       Float    @default(0) @map("used_hours")
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          String   @default("active") // active, expired, exhausted, suspended
  authCode        String?  @map("auth_code")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenantId        String   @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("service_authorizations")
}

model ConsentForm {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  formType         String    @map("form_type") // service_agreement, phipa_consent, dnr, hipaa, general
  status           String    @default("pending") // pending, signed, expired, revoked
  signatureDataUrl String?   @map("signature_data_url")
  signedAt         DateTime? @map("signed_at")
  expiresAt        DateTime? @map("expires_at")
  documentKey      String?   @map("document_key") // R2 storage key for PDF
  witnessName      String?   @map("witness_name")
  templateVersion  Int       @default(1) @map("template_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenantId         String    @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("consent_forms")
}

model DailyAuditSignOff {
  id              String   @id @default(uuid())
  rnId            String   @map("rn_id")
  tenantId        String   @map("tenant_id")
  visitId         String   @unique @map("visit_id")
  clinicalComment String?  @map("clinical_comment")
  status          String   @default("verified") // verified, flagged
  signedAt        DateTime @default(now()) @map("signed_at")

  rn     User   @relation(fields: [rnId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@map("daily_audit_signoffs")
}

model WellnessPulse {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  providerId String?  @map("provider_id")
  tenantId   String   @map("tenant_id")
  status     String // great, okay, struggling, burnout
  score      Int?     @default(5) // 1-10 wellness score
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([providerId])
  @@index([tenantId])
  @@map("wellness_pulses")
}
