// Domain: d_intake.prisma

// 
model PatientIntake {
  id            String    @id @default(uuid())
  tenantId      String
  patientName   String
  status        String // PENDING, SCHEDULED, IN_PROGRESS, APPROVED, DRAFT
  priority      String // LOW, MED, HIGH
  franchiseCity String
  coordinatorId String?
  scheduledDate DateTime?
  scheduledTime String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model IntakeReferralMetric {
  id              String   @id @default(uuid())
  tenantId        String
  sourceName      String
  conversionCount Int      @default(0)
  totalLeads      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
