  unit       String
  source     String   @default("MANUAL") // MANUAL, WEARABLE, DEVICE
  recordedAt DateTime @default(now()) @map("recorded_at")

  patient ClientProfile @relation(fields: [patientId], references: [id])

  @@map("vital_signs")
}

model PatientAlert {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  patientId String   @map("patient_id")
  type      String // CLINICAL, OPERATIONAL, TECHNICAL
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message   String
  status    String   @default("open") // open, acknowledged, resolved
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient ClientProfile @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("patient_alerts")
}

model Medication {
  id           String   @id @default(uuid())
  name         String
  genericName  String?  @map("generic_name")
  dosageForm   String?  @map("dosage_form") // Tablet, Injection, etc.
  strength     String?
  instructions String?
  createdAt    DateTime @default(now()) @map("created_at")

  prescriptions Prescription[]

  @@map("medications")
}

model Prescription {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  patientId    String    @map("patient_id")
  medicationId String    @map("medication_id")
  prescriberId String?   @map("prescriber_id")
  dosage       String
  frequency    String
  route        String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("active") // active, completed, discontinued
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  patient    ClientProfile @relation(fields: [patientId], references: [id])
  medication Medication    @relation(fields: [medicationId], references: [id])
  marEntries MAR_Entry[]

  @@index([tenantId])
  @@map("prescriptions")
}

model MAR_Entry {
  id               String    @id @default(uuid())
  patientId        String?   @map("patient_id")
  clientId         String?   @map("client_id")
  prescriptionId   String?   @map("prescription_id")
  administerId     String?   @map("administer_id") // User ID (PSW, RN)
  administeredById String?   @map("administered_by_id")
  adminTime        DateTime  @default(now()) @map("admin_time")
  scheduledTime    DateTime? @map("scheduled_time")
  administeredAt   DateTime? @map("administered_at")
  status           String    @default("administered") // administered, missed, refused, given, held, not_available
  notes            String?
  medicationName   String?   @map("medication_name")
  dosage           String?
  route            String?
  tenantId         String?   @map("tenant_id")

  patient      ClientProfile? @relation(fields: [patientId], references: [id])
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id])

  @@index([clientId])
  @@index([tenantId])
  @@map("mar_entries")
}

model EVVRecord {
  id                 String   @id @default(uuid())
  visitId            String   @map("visit_id")
  providerId         String   @map("provider_id")
  checkType          String   @map("check_type") // check_in, check_out
  lat                Float?
  lng                Float?
  accuracy           Float?
  verificationMethod String   @default("gps") @map("verification_method") // gps, pin, biometric
  status             String   @default("valid") // valid, exception, overridden
  overrideById       String?  @map("override_by_id")
  overrideReason     String?  @map("override_reason")
  rawData            String?  @map("raw_data")
  capturedAt         DateTime @default(now()) @map("captured_at")
  tenantId           String   @map("tenant_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([visitId])
  @@index([providerId])
  @@map("evv_records")
}

model ServiceAuthorization {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  serviceId       String?  @map("service_id")
  fundingSource   String   @map("funding_source") // ohip, private, insurance, lhin
  authorizedHours Float    @map("authorized_hours")
  usedHours       Float    @default(0) @map("used_hours")
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          String   @default("active") // active, expired, exhausted, suspended
  authCode        String?  @map("auth_code")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenantId        String   @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("service_authorizations")
}

model ConsentForm {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  formType         String    @map("form_type") // service_agreement, phipa_consent, dnr, hipaa, general
  status           String    @default("pending") // pending, signed, expired, revoked
  signatureDataUrl String?   @map("signature_data_url")
  signedAt         DateTime? @map("signed_at")
  expiresAt        DateTime? @map("expires_at")
  documentKey      String?   @map("document_key") // R2 storage key for PDF
  witnessName      String?   @map("witness_name")
  templateVersion  Int       @default(1) @map("template_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenantId         String    @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("consent_forms")
}

model DailyAuditSignOff {
  id              String   @id @default(uuid())
  rnId            String   @map("rn_id")
  tenantId        String   @map("tenant_id")
  visitId         String   @unique @map("visit_id")
  clinicalComment String?  @map("clinical_comment")
  status          String   @default("verified") // verified, flagged
  signedAt        DateTime @default(now()) @map("signed_at")

  rn     User   @relation(fields: [rnId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@map("daily_audit_signoffs")
}

model WellnessPulse {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  providerId String?  @map("provider_id")
  tenantId   String   @map("tenant_id")
  status     String // great, okay, struggling, burnout
  score      Int?     @default(5) // 1-10 wellness score
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([providerId])
  @@index([tenantId])
  @@map("wellness_pulses")
}

// ==========================================
// FINANCIAL ENGINE MODELS (Bank-Level)
// ==========================================

model Invoice {
  id              String        @id @default(uuid())
  clientId        String        @map("client_id")
  status          String?       @default("draft")
  currency        String?       @default("CAD")
  subtotal        Decimal?      @db.Decimal(20, 4)
  tax             Decimal?      @db.Decimal(20, 4)
  total           Decimal?      @db.Decimal(20, 4)
  stripeInvoiceId String?       @map("stripe_invoice_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenantId        String        @map("tenant_id")
  client          ClientProfile @relation(fields: [clientId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  payments        Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Payment {
  id                    String   @id @default(uuid())
  invoiceId             String   @map("invoice_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amount                Decimal? @db.Decimal(20, 4)
  status                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  invoice               Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model InsuranceProvider {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  networkId    String?  @map("network_id")
  contactPhone String?  @map("contact_phone")
  claimsEmail  String?  @map("claims_email")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  claims Claim[]

  @@index([tenantId])
  @@map("insurance_providers")
}

model Claim {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  patientId    String   @map("patient_id")
  providerId   String   @map("provider_id") // InsuranceProvider ID
  serviceDate  DateTime @map("service_date")
  amount       Float
  status       String   @default("draft") // draft, submitted, pending, paid, denied
  denialReason String?  @map("denial_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  patient  ClientProfile     @relation(fields: [patientId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  @@index([tenantId])
  @@map("claims")
}

model BillingCode {
  id          String @id @default(uuid())
  code        String @unique
  description String
  category    String // HCPCS, CPT, ICD-10
  defaultRate Float  @map("default_rate")

  @@map("billing_codes")
}

model Payout {
  id          String    @id @default(uuid())
  providerId  String    @map("provider_id")
  tenantId    String    @map("tenant_id")
  amount      Decimal   @db.Decimal(20, 4)
  currency    String    @default("CAD")
  status      String    @default("pending") // pending, paid, failed
  notes       String?
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payouts")
}

model MileageLog {
  id                  String   @id @default(uuid())
  providerId          String   @map("provider_id")
  date                DateTime
  fromVisitId         String?  @map("from_visit_id")
  toVisitId           String?  @map("to_visit_id")
  fromAddress         String?  @map("from_address")
  toAddress           String?  @map("to_address")
  distanceKm          Float    @map("distance_km")
  travelMinutes       Int?     @map("travel_minutes")
  reimbursementRate   Float    @default(0.70) @map("reimbursement_rate") // CRA 2025 rate
  reimbursementAmount Float?   @map("reimbursement_amount")
  status              String   @default("pending") // pending, approved, paid
  createdAt           DateTime @default(now()) @map("created_at")
  tenantId            String   @map("tenant_id")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([providerId])
  @@map("mileage_logs")
}

model ChartOfAccount {
  id        String   @id @default(uuid())
  code      String // e.g., '1000', '2000'
  name      String // e.g., 'Cash', 'Accounts Receivable'
  type      String
  status    String   @default("active")
  tenantId  String   @map("tenant_id")
  currency  String   @default("CAD")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  journalEntries JournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("financial_accounts")
}

model FinancialTransaction {
  id           String   @id @default(uuid())
  type         String // INVOICE, PAYMENT, PAYROLL, EXPENSE
  referenceId  String?  @map("reference_id") // ID of linked document
  amount       Decimal  @db.Decimal(20, 4)
  currency     String   @default("CAD")
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(20, 4)
  baseAmount   Decimal? @map("base_amount") @db.Decimal(20, 4)
  status       String   @default("draft")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  metadata     Json?    @map("metadata")

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  journalEntries  JournalEntry[]
  reconciliations FinancialReconciliation[]

  @@index([tenantId])
  @@index([referenceId])
  @@map("financial_transactions")
}

model JournalEntry {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  accountId     String   @map("account_id")
  debit         Decimal  @default(0) @db.Decimal(20, 4)
  paidOutAmount Decimal? @map("paid_out_amount") @db.Decimal(20, 4)
  currency      String   @default("CAD")
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(20, 4)
  baseAmount    Decimal? @map("base_amount") @db.Decimal(20, 4)
  balanceBefore Decimal  @default(0) @map("balance_before") @db.Decimal(20, 4)
  balanceAfter  Decimal  @default(0) @map("balance_after") @db.Decimal(20, 4)
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])
  account     ChartOfAccount       @relation(fields: [accountId], references: [id])
  tenant      Tenant               @relation(fields: [tenantId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([tenantId])
  @@map("financial_journal_entries")
}

model FinancialReconciliation {
  id                String    @id @default(uuid())
  transactionId     String    @map("transaction_id")
  bankTransactionId String?   @map("bank_transaction_id")
  status            String    @default("pending") // pending, matched, reconciled
  matchedAt         DateTime? @map("matched_at")
  tenantId          String    @map("tenant_id")

  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id])
  bankTransaction BankTransaction?     @relation(fields: [bankTransactionId], references: [id])
  tenant          Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("financial_reconciliations")
}

model BankTransaction {
  id          String   @id @default(uuid())
  bankDate    DateTime @map("bank_date")
  description String
  amount      Decimal  @db.Decimal(20, 4)
  currency    String   @default("CAD")
  externalRef String?  @map("external_ref")
  status      String   @default("unreconciled") // unreconciled, reconciled, ignored
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  reconciliations FinancialReconciliation[]

  @@index([tenantId])
  @@map("financial_bank_transactions")
}

// ─── Immutable Transaction Ledger ─────────────────────────────────────
// Append-only financial entries with SHA-256 hash chaining.
// NO updatedAt — records are NEVER modified. Corrections are reversal entries.
model TransactionLedger {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  transactionType  String   @map("transaction_type") // PAYMENT, REFUND, ADJUSTMENT, REVERSAL, PAYOUT
  referenceType    String   @map("reference_type") // Invoice, Payout, Claim
  referenceId      String   @map("reference_id")
  debitAccount     String   @map("debit_account") // e.g. "accounts_receivable", "cash"
  creditAccount    String   @map("credit_account") // e.g. "revenue", "refund_payable"
  amount           Decimal  @db.Decimal(20, 4)
  currency         String   @default("CAD")
  exchangeRate     Decimal? @map("exchange_rate") @db.Decimal(20, 4)
  baseAmount       Decimal? @map("base_amount") @db.Decimal(20, 4)
  description      String?
  actorUserId      String?  @map("actor_user_id")
  ipAddress        String?  @map("ip_address")
  checksum         String   @default("") // SHA-256 of this entry
  previousChecksum String?  @map("previous_checksum") // SHA-256 of previous entry
  status           String   @default("sealed") // sealed = immutable, voided = reversed by another entry
  voidedByEntryId  String?  @map("voided_by_entry_id") // links to the reversal entry
  metadata         Json?    @map("metadata")
  createdAt        DateTime @default(now()) @map("created_at")
  // NO updatedAt — records are immutable

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation("LedgerActor", fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("transaction_ledger")
}

