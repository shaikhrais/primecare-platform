  clientId  String   @map("client_id")
  type      String // e.g., 'Observation', 'Condition', 'Medication'
  data      String   @map("data_json") // FHIR-compliant structure
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([clientId])
  @@index([tenantId])
  @@map("clinical_records")
}

model ClinicalAssessment {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  rnId            String   @map("rn_id")
  tenantId        String   @map("tenant_id")
  type            String // ADL, MOBILITY, COGNITIVE, etc.
  assessmentData  Json     @map("assessment_data")
  score           Int?
  recommendations String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  rn     User          @relation(fields: [rnId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("clinical_assessments")
}

model MedicationRecon {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  rnId          String   @map("rn_id")
  tenantId      String   @map("tenant_id")
  reconData     Json     @map("recon_data")
  discrepancies String?
  status        String   @default("completed") // completed, pending_review
  createdAt     DateTime @default(now()) @map("created_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  rn     User          @relation(fields: [rnId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("medication_reconciliations")
}

model SupervisionLog {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  rnId           String   @map("rn_id")
  tenantId       String   @map("tenant_id")
  competencies   String
  isSatisfactory Boolean  @default(true) @map("is_satisfactory")
  feedback       String?
  createdAt      DateTime @default(now()) @map("created_at")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  rn     User            @relation(fields: [rnId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("supervision_logs")
}

model HealthID {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  did       String   @unique // W3C Decentralized Identifier
  publicKey String   @map("public_key")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("health_ids")
}

model FhirSyncLog {
  id           String   @id @default(uuid())
  direction    String // INBOUND, OUTBOUND
  resourceType String   @map("resource_type")
  externalId   String?  @map("external_id")
  status       String // SUCCESS, FAILURE
  error        String?
  timestamp    DateTime @default(now())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("fhir_sync_logs")
}

model VitalSign {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  type       String // HEART_RATE, BLOOD_PRESSURE, OXYGEN_SAT, TEMPERATURE
