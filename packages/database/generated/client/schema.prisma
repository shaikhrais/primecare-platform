  status         String        @default("pending")
  recurrenceRule String?       @map("recurrence_rule")
  tenantId       String        @map("tenant_id")
  client         ClientProfile @relation(fields: [clientId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  visits         Visit[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("bookings")
}

model ProviderAvailability {
  id         String          @id @default(uuid())
  providerId String          @map("provider_id")
  dayOfWeek  Int             @map("day_of_week")
  startTime  String          @map("start_time")
  endTime    String          @map("end_time")
  tenantId   String          @map("tenant_id")
  psw        ProviderProfile @relation("ProviderToAvailability", fields: [providerId], references: [id])
  tenant     Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("provider_availability")
}

model ProviderDocument {
  id         String          @id @default(uuid())
  providerId String          @map("provider_id")
  docType    String          @map("doc_type")
  fileKey    String          @map("file_key")
  status     String?         @default("pending")
  expiryDate DateTime?       @map("expiry_date")
  verifiedBy String?         @map("verified_by")
  verifiedAt DateTime?       @map("verified_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  psw        ProviderProfile @relation("ProviderToDocuments", fields: [providerId], references: [id])
  verifier   User?           @relation("VerifiedBy", fields: [verifiedBy], references: [id])

  @@map("provider_documents")
}

