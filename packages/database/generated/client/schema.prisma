// SCHEDULING & WORKFORCE MODELS
// ==========================================

model ShiftAssignment {
  id         String          @id @default(uuid())
  visitId    String          @map("visit_id")
  providerId String          @map("provider_id")
  status     String          @default("offered")
  score      Float?
  assignedAt DateTime        @default(now()) @map("assigned_at")
  tenantId   String          @map("tenant_id")
  psw        ProviderProfile @relation("ProviderToAssignments", fields: [providerId], references: [id])
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  visit      Visit           @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("shift_assignments")
}

model Timesheet {
  id           String          @id @default(uuid())
  providerId   String          @map("provider_id")
  weekId       String          @map("week_id")
  totalMinutes Int?            @default(0) @map("total_minutes")
  status       String?         @default("draft")
  submittedAt  DateTime?       @map("submitted_at")
  reviewedBy   String?         @map("reviewed_by")
  reviewedAt   DateTime?       @map("reviewed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tenantId     String          @map("tenant_id")
  items        TimesheetItem[]
  psw          ProviderProfile @relation("ProviderToTimesheets", fields: [providerId], references: [id])
  reviewer     User?           @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("timesheets")
}

model TimesheetItem {
  id          String    @id @default(uuid())
  timesheetId String    @map("timesheet_id")
  visitId     String    @map("visit_id")
  minutes     Int
  createdAt   DateTime  @default(now()) @map("created_at")
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
  visit       Visit     @relation(fields: [visitId], references: [id])

  @@map("timesheet_items")
}

model ShiftHandover {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  visitId        String   @map("visit_id")
  tenantId       String   @map("tenant_id")
  handoverNotes  String   @map("handover_notes")
  safetyConcerns String?  @map("safety_concerns")
  suppliesNeeded String?  @map("supplies_needed")
  createdAt      DateTime @default(now()) @map("created_at")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  visit  Visit           @relation(fields: [visitId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("shift_handovers")
}

model AvailabilityOverride {
  id          String   @id @default(uuid())
  providerId  String   @map("provider_id")
  tenantId    String   @map("tenant_id")
  date        DateTime
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")

  psw    ProviderProfile @relation(fields: [providerId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("provider_availability_overrides")
}

model VisitMatch {
  id         String   @id @default(uuid())
  visitId    String   @map("visit_id")
  providerId String   @map("provider_id")
  score      Float
  status     String   @default("pending") // pending, rejected, accepted
  createdAt  DateTime @default(now()) @map("created_at")
  tenantId   String   @map("tenant_id")

  visit  Visit           @relation(fields: [visitId], references: [id])
  psw    ProviderProfile @relation("VisitMatches", fields: [providerId], references: [id])
  tenant Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("visit_matches")
}

model WaitlistEntry {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  serviceId        String    @map("service_id")
  priority         Int       @default(0)
  status           String    @default("active") // active, matched, cancelled
  notes            String?
  requestedStartAt DateTime? @map("requested_start_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  tenantId         String    @map("tenant_id")

  client  ClientProfile @relation(fields: [clientId], references: [id])
  service Service       @relation(fields: [serviceId], references: [id])
  tenant  Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("waitlist_entries")
}

model StaffTask {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("todo") // todo, in_progress, completed, blocked
  priority    String    @default("medium") // low, medium, high, urgent
  dueDate     DateTime? @map("due_date")
  assigneeId  String?   @map("assignee_id")
  groupId     String?   @map("group_id") // Assigned to a specific Admin Group rather than an individual
  tenantId    String    @map("tenant_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  group    StaffGroup? @relation(fields: [groupId], references: [id])
  assignee User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@map("staff_tasks")
}

model StaffGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  members StaffGroupMember[]
  tasks   StaffTask[]

  @@index([tenantId])
  @@map("staff_groups")
}

model StaffGroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  role      String   @default("member") // admin/leader, member
  createdAt DateTime @default(now()) @map("created_at")

  group StaffGroup @relation(fields: [groupId], references: [id])
  user  User       @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@map("staff_group_members")
}

model BookingRequest {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  tenantId      String   @map("tenant_id")
  serviceType   String   @map("service_type")
  preferredDate DateTime @map("preferred_date")
  preferredTime String?  @map("preferred_time")
  notes         String?
  status        String   @default("pending") // pending, approved, rejected, cancelled
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("booking_requests")
}

model FleetStatus {
  id              String          @id @default(uuid())
  providerId      String          @unique @map("provider_id")
  lat             Float?
  lng             Float?
  status          String          @default("available") // available, en_route, on_site, offline
  batteryLevel    Int?            @map("battery_level")
  lastHeartbeatAt DateTime        @default(now()) @map("last_heartbeat_at")
  currentVisitId  String?         @map("current_visit_id")
  psw             ProviderProfile @relation(fields: [providerId], references: [id])

  @@map("fleet_status")
}

// ==========================================
// CLINICAL OPERATIONS MODELS
// ==========================================

model CarePlan {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  tenantId      String    @map("tenant_id")
  diagnoses     String
  clinicalGoals String?   @map("clinical_goals")
  interventions String?   @map("interventions")
  status        String    @default("active") // active, completed, archived
  reviewDate    DateTime? @map("review_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  // RN Mastery Extensions
  authorId     String? @map("author_id")
  version      Int     @default(1)
  isArchived   Boolean @default(false) @map("is_archived")
  outcomeNotes String? @map("outcome_notes")
  author       User?   @relation("CarePlanAuthor", fields: [authorId], references: [id])

  @@index([tenantId])
  @@map("care_plans")
}

model ClinicalRecord {
