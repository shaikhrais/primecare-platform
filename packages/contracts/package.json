{
  "name": "@primecare/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-generated TypeScript types from the PrimeCare Worker API OpenAPI specification",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o generated/api.d.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  }
}
