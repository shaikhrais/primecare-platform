{
  "name": "primecare-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "apps/cypress-test",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@primecare/worker-api",
    "dev:admin": "npm run dev --workspace=@primecare/web-admin",
    "dev:web": "npm run dev --workspace=prime-care-web-marketing",
    "api:spec": "node scripts/export-openapi.mjs",
    "api:types": "npx openapi-typescript packages/contracts/openapi.json -o packages/contracts/generated/api.d.ts",
    "api:generate": "npm run api:spec && npm run api:types",
    "turbo:build": "npx turbo build",
    "turbo:typecheck": "npx turbo typecheck",
    "turbo:test": "npx turbo test",
    "turbo:lint": "npx turbo lint"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "esbuild": "^0.27.2",
    "pg": "8.11.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.57.1"
  },
  "devDependencies": {
    "@eslint/js": "9.25.0",
    "@testing-library/dom": "^10.4.1",
    "cypress": "^15.10.0",
    "eslint": "9.25.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "ts-morph": "^27.0.2",
    "turbo": "^2.8.17",
    "typescript-eslint": "8.30.1",
    "wrangler": "^4.68.1"
  },
  "overrides": {
    "zod": "3.23.8"
  }
}
