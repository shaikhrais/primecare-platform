{
  "name": "primecare-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "apps/cypress-test",
    "packages/*",
    "services/*",
    "archive/services/auth-service",
    "archive/services/client-service"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@primecare/worker-api",
    "dev:web": "npm run dev --workspace=prime-care-web-marketing",
    "api:spec": "node scripts/export-openapi.mjs",
    "api:types": "npx openapi-typescript packages/contracts/openapi.json -o packages/contracts/generated/api.d.ts",
    "api:generate": "npm run api:spec && npm run api:types",
    "turbo:build": "npx turbo build",
    "turbo:typecheck": "npx turbo typecheck",
    "turbo:test": "npx turbo test",
    "test:fast": "vitest run",
    "test": "npm run test:fast",
    "turbo:lint": "npx turbo lint",
    "dev:services": "turbo run dev --filter='./archive/services/*'",
    "verify": "powershell -ExecutionPolicy Bypass -File .\\scripts\\preflight.ps1",
    "checkpoint": "powershell -ExecutionPolicy Bypass -File .\\scripts\\checkpoint.ps1",
    "dev:safe:api": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run_safe.ps1 -Target dev:api",
    "dev:safe:web": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run_safe.ps1 -Target dev:web",
    "pdm:pulse": "python scripts/pdm/pdm_engine.py && python scripts/pdm/pdm_advanced_report.py && npx tsx packages/database/pdm_cloud_sync.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "decimal.js": "^10.6.0",
    "esbuild": "^0.27.2",
    "pg": "8.11.3",
    "stripe": "^22.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.57.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260403.1",
    "@eslint/js": "9.25.0",
    "@faker-js/faker": "^10.4.0",
    "@testing-library/dom": "^10.4.1",
    "cypress": "^15.10.0",
    "eslint": "9.25.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ts-morph": "^27.0.2",
    "turbo": "^2.8.17",
    "typescript-eslint": "8.30.1",
    "vitest": "^4.1.4",
    "wrangler": "^4.68.1"
  },
  "overrides": {
    "zod": "3.23.8"
  },
  "lint-staged": {
    "*.dart": [
      "dart format",
      "dart analyze --fatal-infos"
    ],
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  }
}
