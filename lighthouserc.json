{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web-admin/dist",
      "url": ["http://localhost/"],
      "numberOfRuns": 1
    },
    "assert": {
      "budgetFile": "lighthouse-budget.json",
      "assertions": {
        "performance-budget": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
