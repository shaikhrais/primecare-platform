<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PrimeCare L3 Functional Suite">
    <parameter name="level" value="3" />
    <listeners>
        <listener class-name="primecare.testing.listeners.ExecutionListener" />
        <listener class-name="primecare.testing.listeners.TestResultListener" />
        <listener class-name="primecare.testing.listeners.DependencyListener" />
        <listener class-name="primecare.testing.listeners.RetryListener" />
        <listener class-name="primecare.testing.listeners.GovernanceReporter" />
    </listeners>
    <test name="PrimeCare L3 Functional Tests">
        <classes>
            <class name="primecare.testing.framework.PrimeCareLayerTestFactory" />
        </classes>
    </test>
</suite>
