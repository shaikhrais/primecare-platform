<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PrimeCare PSW Dashboard Suite">
    <parameter name="screen" value="psw_dashboard" />
    <parameter name="level" value="1" />
    <listeners>
        <listener class-name="primecare.testing.listeners.ExecutionListener" />
        <listener class-name="primecare.testing.listeners.TestResultListener" />
        <listener class-name="primecare.testing.listeners.DependencyListener" />
        <listener class-name="primecare.testing.listeners.RetryListener" />
        <listener class-name="primecare.testing.listeners.GovernanceReporter" />
    </listeners>
    <test name="PrimeCare PSW Dashboard Tests">
        <classes>
            <class name="primecare.testing.framework.factory.PrimeCareLayerTestFactory" />
        </classes>
    </test>
</suite>
