{
  "version": 1,
  "requirement": "Short-lived relay preparation for current same-tenant participants of an unexpired ringing or accepted internal call. No microphone acquisition, audio transmission or SDP exchange before acceptance. Native current session, command/media/prepare API and screen grants, quota, and participant checks before and after issuance.",
  "implementationStatus": "registered-unimplemented",
  "activation": false,
  "service": "governance",
  "anchorApiId": 710,
  "operations": [
    {
      "key": "call.prepare",
      "method": "POST",
      "path": "/v1/calls/prepare",
      "authentication": "native-session-csrf",
      "responseKind": "json",
      "permission": "role_screen_permissions",
      "request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,199}$"
          },
          "callId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,199}$"
          }
        },
        "required": [
          "id",
          "callId"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "iceServers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "username": {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512
                },
                "credential": {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512
                }
              },
              "required": [
                "urls"
              ],
              "additionalProperties": false
            }
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          }
        },
        "required": [
          "iceServers",
          "expiresAt"
        ],
        "additionalProperties": false
      }
    }
  ]
}
