{
  "id": "auth-lifecycle-surface-v1",
  "policyId": "auth-lifecycle-completion-v1",
  "screenId": 949,
  "file": "packages/primecare_ui/lib/src/features/auth/mfa_management_form.dart",
  "endpoints": [
    {
      "code": "auth_mfa_lifecycle_codes",
      "route": "/v1/auth/mfa/recovery-codes",
      "authenticated": 1,
      "permission": "self_code_admin_mfa",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum 72 UTF-8 bytes"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "recoveryCodes"
        ],
        "properties": {
          "status": {
            "const": "recovery_codes_issued"
          },
          "recoveryCodes": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[A-Z2-7]{26}$"
            }
          }
        }
      }
    },
    {
      "code": "auth_mfa_lifecycle_replace",
      "route": "/v1/auth/mfa/replacement",
      "authenticated": 1,
      "permission": "self_code_admin_mfa",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum 72 UTF-8 bytes"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "challenge",
          "setupKey"
        ],
        "properties": {
          "status": {
            "const": "mfa_replacement_required"
          },
          "challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "setupKey": {
            "type": "string",
            "pattern": "^[A-Z2-7]{32}$"
          }
        }
      }
    },
    {
      "code": "auth_mfa_lifecycle_recover",
      "route": "/v1/auth/mfa/recovery",
      "authenticated": 0,
      "permission": "password_verified_mfa_replacement_challenge",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge",
          "recoveryCode"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "recoveryCode": {
            "type": "string",
            "pattern": "^[A-Z2-7]{26}$"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "challenge",
          "setupKey"
        ],
        "properties": {
          "status": {
            "const": "mfa_replacement_required"
          },
          "challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "setupKey": {
            "type": "string",
            "pattern": "^[A-Z2-7]{32}$"
          }
        }
      }
    },
    {
      "code": "auth_mfa_lifecycle_confirm",
      "route": "/v1/auth/mfa/replacement/confirm",
      "authenticated": 0,
      "permission": "password_verified_mfa_replacement_challenge",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge",
          "code"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "token",
          "userId",
          "role"
        ],
        "properties": {
          "status": {
            "const": "authenticated"
          },
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "const": "code_admin"
          }
        }
      }
    }
  ],
