  "operations": {
    "create": {
      "apiId": 1,
      "path": "/v1/auth/register",
      "method": "POST",
      "actors": [
        "ceo",
        "hr_director"
      ],
      "flow": "auth.create-tenant-account",
      "permission": "auth_account_creation_policy"
    },
    "save": {
      "apiId": 11,
      "path": "/v1/admin/users",
      "method": "POST",
      "actors": [
        "ceo"
      ],
      "flow": "auth.manage-account",
      "permission": "auth_account_management_policy"
    },
    "revoke": {
      "apiId": 16422,
      "path": "/v1/admin/users/{userId}/sessions",
      "method": "DELETE",
      "actors": [
        "ceo"
      ],
      "flow": "auth.revoke-account-sessions",
      "permission": "auth_account_management_policy"
    }
  }
