{
  "id": "auth-elevation-surface-v1",
  "policyId": "auth-lifecycle-completion-v1",
  "action": "tenant_security_summary",
  "maximumSeconds": 900,
  "endpoints": [
    {
      "code": "auth_elevation",
      "route": "/v1/auth/mfa/elevation",
      "method": "POST",
      "permission": "self_code_admin_elevation",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "code",
          "reason",
          "scope",
          "seconds"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "Maximum 72 UTF-8 bytes; compare against current actor password"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "tenant_security_summary"
            }
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "elevationId",
          "expiresAt",
          "scope"
        ],
        "properties": {
          "status": {
            "const": "elevated"
          },
          "elevationId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "tenant_security_summary"
            }
          }
        }
      }
    },
    {
      "code": "auth_elevation_revoke",
      "route": "/v1/auth/mfa/elevation/revoke",
      "method": "POST",
      "permission": "self_code_admin_elevation",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "elevationId"
        ],
        "properties": {
          "elevationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "revoked"
          }
        }
      }
    },
    {
      "code": "auth_support_request",
      "route": "/v1/auth/mfa/support/request",
      "method": "POST",
      "permission": "elevated_code_admin_support_request",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "elevationId",
          "tenantId",
          "ticket",
          "reason",
          "scope",
          "seconds"
        ],
        "properties": {
          "elevationId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "ticket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "tenant_security_summary"
            }
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "requesterId",
          "tenantId",
          "ticket",
          "reason",
          "scope",
          "expiresAt",
          "state"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "requesterId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "ticket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "tenant_security_summary"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": [
              "pending",
              "approved",
              "revoked"
            ]
          }
        }
      }
    },
    {
      "code": "auth_support_requests",
      "route": "/v1/auth/mfa/support/requests",
      "method": "GET",
      "permission": "tenant_admin_support_approval",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requests"
        ],
        "properties": {
          "requests": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requestId",
                "requesterId",
                "tenantId",
                "ticket",
                "reason",
                "scope",
                "expiresAt",
                "state"
              ],
              "properties": {
                "requestId": {
                  "type": "string",
                  "format": "uuid"
                },
                "requesterId": {
                  "type": "string",
                  "format": "uuid"
                },
                "tenantId": {
                  "type": "string",
                  "format": "uuid"
                },
                "ticket": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "reason": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 500
                },
                "scope": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "const": "tenant_security_summary"
                  }
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "state": {
                  "enum": [
                    "pending",
                    "approved",
                    "revoked"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "code": "auth_support_approve",
      "route": "/v1/auth/mfa/support/approve",
      "method": "POST",
      "permission": "tenant_admin_support_approval",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "password"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "Maximum 72 UTF-8 bytes; compare against current actor password"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "requestId",
          "expiresAt"
        ],
        "properties": {
          "status": {
            "const": "approved"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "code": "auth_support_revoke",
      "route": "/v1/auth/mfa/support/revoke",
      "method": "POST",
      "permission": "owned_or_tenant_admin_support_revocation",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "password"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "Maximum 72 UTF-8 bytes; compare against current actor password"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "revoked"
          }
        }
      }
    },
    {
      "code": "auth_support_summary",
      "route": "/v1/auth/mfa/support/summary",
      "method": "POST",
      "permission": "approved_tenant_security_summary",
      "authenticated": 1,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "activeAccounts",
          "activeSessions",
          "enrolledAuthenticators"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "activeAccounts": {
            "type": "integer",
            "minimum": 0
          },
          "activeSessions": {
            "type": "integer",
            "minimum": 0
          },
          "enrolledAuthenticators": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ],
