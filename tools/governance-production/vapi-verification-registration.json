{
  "version": 1,
  "requirement": "Caller-authorized spoken SMS verification only: dedicated provider credential, canonical active Vapi/Twilio call and unique existing verified account contact; Twilio generates and checks codes. Durable call/account/contact-version binding, phone send quotas, two minute expiry, five checks, no raw code storage, no business action approval or native login. Registering creates no grants, calls, SMS or deployment.",
  "implementationStatus": "registered-unimplemented",
  "activation": false,
  "service": "governance",
  "anchorApiId": 710,
  "operations": [
    {
      "key": "vapi.verification",
      "method": "POST",
      "path": "/v1/vapi/voice/verification",
      "authentication": "vapi-service-credential-and-canonical-call",
      "responseKind": "json",
      "permission": "vapi.service.verification",
      "request": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "object",
            "required": [
              "type",
              "call",
              "toolCallList"
            ],
            "properties": {
              "type": {
                "const": "tool-calls"
              },
              "call": {
                "type": "object"
              },
              "toolCallList": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "maxItems": 1
          }
        }
      }
    }
  ]
}
