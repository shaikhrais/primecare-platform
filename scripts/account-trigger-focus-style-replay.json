      "edits": [
        {
          "begin": 194,
          "old": "",
          "new": "import 'package:flutter_core/theme/prime_account_trigger_focus_frame.dart';\nimport 'package:flutter_core/theme/theme_contrast.dart';\n\nFinder findAccountPopupItem(String label) => find.ancestor(\n  of: find.text(label),\n  matching: find.byWidgetPredicate((widget) => widget is PopupMenuItem<String>),\n);\n"
        },
        {
          "begin": 1005,
          "old": "",
          "new": "  final triggerInk = find.descendant(of: trigger, matching: find.byType(InkWell));\n  expect(triggerInk, findsOneWidget);\n  expect(Theme.of(tester.element(triggerInk)).focusColor, Colors.transparent);\n  final focusFrame = find.descendant(\n    of: trigger,\n    matching: find.byType(PrimeAccountTriggerFocusFrame),\n  );\n  final surface =\n      tester.widget<PrimeAccountTriggerFocusFrame>(focusFrame).surface;\n  final outline = tester.widget<DecoratedBox>(\n    find.descendant(\n      of: focusFrame,\n      matching: find.byKey(PrimeAccountTriggerFocusFrame.outlineKey),\n    ),\n  ).decoration as BoxDecoration;\n  final color = (outline.border! as Border).top.color;\n  expect(\n    themeContrastRatio(color, surface),\n    greaterThanOrEqualTo(3),\n  );\n"
        },
        {
          "begin": 1371,
          "old": "  final signOut = find.widgetWithText(PopupMenuItem<String>, 'Sign out');\n",
          "new": "  final signOut = findAccountPopupItem('Sign out');\n"
        },
        {
          "begin": 1480,
          "old": "  expect(find.widgetWithText(PopupMenuItem<String>, 'Switch role'), findsNothing);\n",
          "new": "  expect(findAccountPopupItem('Switch role'), findsNothing);\n"
        },
        {
          "begin": 1816,
          "old": "",
          "new": "  final menuInk = find.descendant(of: signOut, matching: find.byType(InkWell));\n  expect(menuInk, findsOneWidget);\n  expect(\n    Theme.of(tester.element(menuInk)).focusColor,\n    Theme.of(target).focusColor,\n  );\n"
        }
      ]
