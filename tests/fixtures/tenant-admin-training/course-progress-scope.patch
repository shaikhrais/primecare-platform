@@ -11,3 +11,20 @@ test('invalid input and storage failure cannot create a passed record',()=>{
 test('corrupt, oversized and unknown results are rejected; reset removes only current account',()=>{
  const p=new TrainingProgress('https://one','a',storage);const key=[...values.keys()][0];values.set(key,'x'.repeat(32769));assert.deepEqual(p.results(),[]);values.set(key,JSON.stringify(Array(9).fill({lesson:'authority',passedAt:'2026-10-13'})));assert.deepEqual(p.results(),[]);values.set(key,'{invalid');assert.deepEqual(p.results(),[]);values.set(key,JSON.stringify([{lesson:'unknown',passedAt:'2026-10-13'}, {lesson:'authority',passedAt:'invalid'}]));assert.deepEqual(p.results(),[]);p.answer('authority',1);const other=new TrainingProgress('https://one','b',storage);other.answer('authority',1);p.reset();assert.equal(p.results().length,0);assert.equal(other.results().length,1);
 });
+test('a separate course never reads or resets the shared course, even with identical lesson IDs and versions',()=>{
+ const entries=new Map();const isolatedStorage={getItem:key=>entries.get(key)??null,setItem:(key,value)=>entries.set(key,value),removeItem:key=>entries.delete(key)};
+ const gateway='https://course.example';const actor='test-account';
+ const shared=new TrainingProgress(gateway,actor,isolatedStorage);const version=shared.summary().version;
+ // Pre-existing installations used this exact key for the shared course.
+ const oldKey='primecare.training.v1.'+encodeURIComponent(gateway)+'.'+encodeURIComponent(actor)+'.'+version;
+ entries.set(oldKey,JSON.stringify([{lesson:'authority',passedAt:'2026-10-13T00:00:00Z'}]));
+ assert.equal(shared.results().length,1);
+ const fixture={course:'fixture-other-course',version,modules:[{id:'authority',correct:0}]};
+ const separate=new TrainingProgress(gateway+'/',actor,isolatedStorage,fixture);
+ assert.deepEqual(separate.results(),[]);assert.equal(separate.answer('authority',1),false);assert.equal(separate.answer('authority',0),true);
+ const readback=new TrainingProgress(gateway,actor,isolatedStorage,fixture);
+ assert.equal(readback.results().length,1);assert.equal(readback.summary().course,fixture.course);assert.equal(readback.summary().total,1);
+ assert.deepEqual(new TrainingProgress(gateway,actor,isolatedStorage,{...fixture,version:version+'.next'}).results(),[]);
+ assert.deepEqual(new TrainingProgress(gateway,'another-account',isolatedStorage,fixture).results(),[]);
+ readback.reset();assert.deepEqual(readback.results(),[]);assert.equal(shared.results().length,1);
+});
