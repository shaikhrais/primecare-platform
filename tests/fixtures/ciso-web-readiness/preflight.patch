+test('CISO authorized readiness uses only screens, honors status and preserves other roles',async()=>{
+ const {dom,root,data}=browser('ciso');
+ try{
+  const target=data.screens.find(p=>p.code==='ciso_dashboard');
+  assert.equal(target.route,'/offices/corporate/roles/ciso/dashboard');
+  const pending=data.screens.find(p=>p.code==='ciso_analytics');
+  const unknown=data.screens.find(p=>p.code==='ciso_compliance');
+  target.productionReady=true;target.blockers=['Historical issue left in fixture'];
+  pending.productionReady=false;pending.blockers=[];
+  delete unknown.productionReady;unknown.blockers=[];
+  data.inventory=[...data.screens,{...pending,code:'inventory_only_canary',name:'Inventory-only canary',route:'/inventory-only-canary'}];
+  await renderWorkspace(root,'https://gateway.test');
+  assert.equal(location.pathname,target.route);
+  assert.ok(root.querySelector('[data-cy="screen-ciso_dashboard"]'));
+  assert.equal(root.querySelector('[data-cy="inventory-inventory_only_canary"]'),null);
+  assert.ok(!root.textContent.includes('Inventory-only canary'));
+  const row=code=>root.querySelector('[data-cy="inventory-'+code+'"]');
+  assert.match(row(target.code).textContent,/Marked ready/);
+  assert.match(row(pending.code).textContent,/Not marked ready/);
+  assert.match(row(unknown.code).textContent,/Readiness unknown/);
+  assert.ok(inventoryCsv([unknown],'Readiness unknown').includes('"Readiness unknown"'));
+  assert.ok(row(target.code).querySelector('[data-cy="delivery-ciso_dashboard"]').textContent.includes('Historical issue left in fixture'));
+  root.querySelector('[data-cy="workspace-inventory"]').open=true;
+  const filter=root.querySelector('[data-cy="workspace-pending"]');
+  filter.checked=true;filter.dispatchEvent(new window.Event('change'));
+  assert.equal(row(target.code),null,'Ready stays excluded even with historical blockers');
+  assert.ok(row(pending.code),'Non-ready with no blocker still requires review');
+  assert.ok(row(unknown.code),'Unknown stays visible under unfinished');
+  const search=root.querySelector('[data-cy="workspace-search"]');
+  search.value='definitely-no-match';search.dispatchEvent(new window.Event('input'));
+  assert.equal(root.querySelector('[data-cy="readiness-empty"]').getAttribute('role'),'status');
+  assert.equal(root.querySelector('[data-cy="workspace-inventory"]').open,true);
+  assert.equal(document.activeElement.getAttribute('data-cy'),'workspace-search');
+  search.value='';root.querySelector('[data-cy="workspace-search"]').value='';
+  root.querySelector('[data-cy="workspace-search"]').dispatchEvent(new window.Event('input'));
+  assert.equal(root.querySelector('[data-cy="readiness-empty"]'),null);
+ }finally{dom.window.close();}
+ const previous=browser('ceo');
+ try{
+  await renderWorkspace(previous.root,'https://gateway.test');
+  assert.equal(previous.root.querySelector('[data-cy="readiness-empty"]'),null);
+  assert.match(previous.root.querySelector('[data-cy="workspace-inventory"]').textContent,/Page inventory/);
+  assert.match(previous.root.querySelector('[data-cy="inventory-ceo_dashboard"]')?.textContent??previous.root.querySelector('[data-cy="workspace-inventory"] tbody tr').textContent,/Page created/);
+  history.pushState({},'','/offices/corporate/roles/ciso/dashboard?enable-semantics=true');
+  window.dispatchEvent(new window.PopStateEvent('popstate'));
+  assert.ok(previous.root.querySelector('[data-cy="error-state"]'));
+  assert.equal(previous.root.querySelector('[data-cy="screen-ciso_dashboard"]'),null);
+ }finally{previous.dom.window.close();}
+});
