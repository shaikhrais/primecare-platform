+
+/** PROTOTYPE: explicit marker for one confirmed legacy detail; never omit events.
+ * Requires response-contract review before product publication. The strict
+ * projector remains unchanged for all other historical fields and consumers. */
+export type AdministrationAuditHistoryEvent=AdministrationAuditEvent&{unavailable_details?:['previous_state.status']};
+export function projectAdministrationAuditHistory(raw:unknown):AdministrationAuditHistoryEvent{
+ const row=object(raw);
+ if(Object.hasOwn(row,'unavailable_details')){
+  if(row.action!=='account_updated'||!Array.isArray(row.unavailable_details)||row.unavailable_details.length!==1||row.unavailable_details[0]!=='previous_state.status'||Object.hasOwn(object(row.previous_state),'status'))return invalid();
+  return {...projectAdministrationAudit(row),unavailable_details:['previous_state.status']};
+ }
+ if(row.action!=='account_updated')return projectAdministrationAudit(row);
+ const previous=object(row.previous_state);
+ if(!Object.hasOwn(previous,'status')||previous.status==='active'||previous.status==='inactive')return projectAdministrationAudit(row);
+ const value=previous.status;
+ // Null or an unsupported bounded printable legacy string only. Objects,
+ // arrays, control characters, booleans, numbers and oversized values stay fatal.
+ if(value!==null&&(typeof value!=='string'||!value.trim()||value.length>150||/[\u0000-\u001f\u007f]/.test(value)))return invalid();
+ const {status:unavailable,...safePrevious}=previous;
+ return {...projectAdministrationAudit({...row,previous_state:safePrevious}),unavailable_details:['previous_state.status']};
+}
