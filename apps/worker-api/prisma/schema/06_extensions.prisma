// ==========================================
// EXTENSION MODULES
// ==========================================

model BlogPost {
  id                String    @id @default(uuid())
  title             String
  slug              String    @unique
  excerpt           String?
  contentHtml       String?   @map("content_html")
  status            String?   @default("draft")
  publishedAt       DateTime? @map("published_at")
  authorUserId      String?   @map("author_user_id")
  featureImageDocId String?   @map("feature_image_doc_id")
  seoTitle          String?   @map("seo_title")
  seoDescription    String?   @map("seo_description")
  canonicalUrl      String?   @map("canonical_url")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  author            User?     @relation(fields: [authorUserId], references: [id])
  targetRole        String?   @map("target_role")
  category          String?   @default("announcement")

  @@map("blog_posts")
}

model Feedback {
  id        String        @id @default(uuid())
  clientId  String        @map("client_id")
  visitId   String?       @map("visit_id")
  rating    Int
  comment   String?
  status    String?       @default("pending") // pending, reviewed, archived
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenantId  String        @map("tenant_id")
  client    ClientProfile @relation(fields: [clientId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  visit     Visit?        @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@map("feedbacks")
}

model TrainingModule {
  id          String               @id @default(uuid())
  title       String
  description String?
  category    String?
  videoUrl    String?              @map("video_url")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  tenantId    String               @map("tenant_id")
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  assignments TrainingAssignment[]

  @@index([tenantId])
  @@map("training_modules")
}

model TrainingAssignment {
  id          String         @id @default(uuid())
  pswId       String?        @map("psw_id")
  staffId     String?        @map("staff_id")
  moduleId    String         @map("module_id")
  status      String         @default("assigned") // assigned, completed
  completedAt DateTime?      @map("completed_at")
  assignedAt  DateTime       @default(now()) @map("assigned_at")
  dueDate     DateTime?      @map("due_date")
  module      TrainingModule @relation(fields: [moduleId], references: [id])

  @@map("training_assignments")
}

model Survey {
  id         String           @id @default(uuid())
  title      String
  targetRole String?          @map("target_role")
  questions  Json             @map("questions_json")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")
  tenantId   String           @map("tenant_id")
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  responses  SurveyResponse[]

  @@index([tenantId])
  @@map("surveys")
}

model SurveyResponse {
  id        String   @id @default(uuid())
  surveyId  String   @map("survey_id")
  userId    String   @map("user_id")
  answers   Json     @map("answers_json")
  createdAt DateTime @default(now()) @map("created_at")
  survey    Survey   @relation(fields: [surveyId], references: [id])

  @@map("survey_responses")
}

model Region {
  id        String           @id @default(uuid())
  name      String           @unique
  city      String
  province  String
  boundary  String?          @map("boundary_json")
  status    String           @default("active")
  createdAt DateTime         @default(now()) @map("created_at")
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  stats     BranchCapacity[]

  @@index([tenantId])
  @@map("regions")
}

model BranchCapacity {
  id              String   @id @default(uuid())
  regionId        String   @map("region_id")
  totalStaff      Int      @default(0) @map("total_staff")
  availableStaff  Int      @default(0) @map("available_staff")
  activeVisits    Int      @default(0) @map("active_visits")
  pendingBookings Int      @default(0) @map("pending_bookings")
  utilizationRate Float?   @map("utilization_rate")
  timestamp       DateTime @default(now())
  region          Region   @relation(fields: [regionId], references: [id])

  @@map("branch_capacity")
}

model BranchStat {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  utilization     Float
  revenue         Float
  churnRate       Float    @map("churn_rate")
  activeClients   Int      @map("active_clients")
  activeProviders Int      @map("active_providers")
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("branch_stats")
}

model ComplianceRecord {
  id         String   @id @default(uuid())
  type       String // e.g., "document_audit", "training_completion"
  status     String   @default("pending") // pending, compliant, non_compliant
  score      Float?
  notes      String?
  lastSyncAt DateTime @default(now()) @map("last_sync_at")
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("compliance_records")
}

model Franchise {
  id          String   @id @default(uuid())
  name        String
  resellerId  String   @map("reseller_id") // The tenant that acts as reseller
  ownerUserId String   @map("owner_user_id")
  status      String   @default("active") // active, suspended, terminated
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reseller   Tenant              @relation("ResellerTenants", fields: [resellerId], references: [id])
  agreements ResellerAgreement[]
  clients    ClientProfile[]

  @@map("franchises")
}

model ResellerAgreement {
  id            String    @id @default(uuid())
  franchiseId   String    @map("franchise_id")
  terms         String
  feePercentage Float     @map("fee_percentage")
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  status        String    @default("active")

  franchise Franchise @relation(fields: [franchiseId], references: [id])

  @@map("reseller_agreements")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?         @map("contact_name")
  email          String?
  phone          String?
  category       String // MEDICAL_DEVICES, CONSUMABLES, PHARMACEUTICALS
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at")
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model InventoryItem {
  id              String         @id @default(uuid())
  name            String
  sku             String         @unique
  category        String
  quantity        Int            @default(0)
  reorderPoint    Int            @default(10) @map("reorder_point")
  unitPrice       Float          @map("unit_price")
  tenantId        String         @map("tenant_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  ClientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])
  clientProfileId String?

  @@index([tenantId])
  @@map("inventory_items")
}

model PurchaseOrder {
  id              String         @id @default(uuid())
  poNumber        String         @unique @map("po_number")
  supplierId      String         @map("supplier_id")
  tenantId        String         @map("tenant_id")
  totalAmount     Float          @map("total_amount")
  status          String         @default("draft") // draft, sent, received, cancelled
  createdAt       DateTime       @default(now()) @map("created_at")
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  ClientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])
  clientProfileId String?

  @@index([tenantId])
  @@map("purchase_orders")
}

model TelehealthSession {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  patientId   String    @map("patient_id") // ClientProfile ID
  providerId  String    @map("provider_id") // User ID (RN, PSW, etc.)
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  meetingLink String?   @map("meeting_link")
  status      String    @default("scheduled") // scheduled, in-progress, completed, cancelled
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  patient  ClientProfile @relation(fields: [patientId], references: [id])
  provider User          @relation(fields: [providerId], references: [id])

  @@index([tenantId])
  @@map("telehealth_sessions")
}

model MarketplaceListing {
  id          String   @id @default(uuid())
  title       String
  description String
  total       Decimal
  category    String
  providerId  String   @map("provider_id")
  tenantId    String?  @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("marketplace_listings")
}

model TenantSLA {
  id                 String   @id @default(uuid())
  uptimeTarget       Float    @default(99.9) @map("uptime_target")
  responseTimeTarget Int      @default(500) @map("response_time_target") // ms
  supportTier        String   @default("STANDARD") @map("support_tier") // BRONZE, SILVER, GOLD, PLATINUM
  status             String   @default("compliant")
  lastAuditAt        DateTime @default(now()) @map("last_audit_at")
  tenantId           String   @unique @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_slas")
}

model AIRecommendation {
  id        String   @id @default(uuid())
  type      String // e.g., 'Staffing', 'Clinical', 'Financial'
  priority  String // LOW, MEDIUM, HIGH, CRITICAL
  content   String
  isApplied Boolean  @default(false) @map("is_applied")
  createdAt DateTime @default(now()) @map("created_at")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ai_recommendations")
}

model SentimentAnalysis {
  id        String   @id @default(uuid())
  source    String // 'VisitNote', 'SupportChat', 'Survey'
  sourceId  String   @map("source_id")
  score     Float // -1.0 to 1.0
  magnitude Float
  entities  String?
  createdAt DateTime @default(now()) @map("created_at")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("sentiment_analysis")
}

model SecurityThreat {
  id          String    @id @default(uuid())
  type        String // e.g., 'BRUTE_FORCE', 'SQL_INJECTION', 'ANOMALOUS_LOGON'
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("detected") // detected, mitigating, resolved
  description String
  source      String? // IP address or user ID
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("security_threats")
}

model TechnicalAudit {
  id            String   @id @default(uuid())
  type          String   @map("audit_type") // LINK_REGISTRY, BUTTON_REGISTRY, etc.
  status        String   @default("success")
  summary       String
  issuesCount   Int      @default(0) @map("issues_count")
  details       String?
  performedById String?  @map("performed_by_id")
  performedAt   DateTime @default(now()) @map("performed_at")
  tenantId      String?  @map("tenant_id")

  performedBy User?   @relation("PerformedAudits", fields: [performedById], references: [id])
  tenant      Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("technical_audits")
}

model FamilyNotification {
  id        String        @id @default(uuid())
  clientId  String        @map("client_id")
  type      String // VISIT_STARTED, ALERT, BILLING
  message   String
  isRead    Boolean       @default(false) @map("is_read")
  createdAt DateTime      @default(now()) @map("created_at")
  client    ClientProfile @relation(fields: [clientId], references: [id])
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("family_notifications")
}

model CareFeedback {
  id              String        @id @default(uuid())
  clientId        String        @map("client_id")
  visitId         String        @map("visit_id")
  rating          Int
  comment         String?
  triageStatus    String        @default("pending") @map("triage_status")
  resolutionNotes String?       @map("resolution_notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  client          ClientProfile @relation(fields: [clientId], references: [id])
  visit           Visit         @relation(fields: [visitId], references: [id])
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("care_feedbacks")
}

model Referral {
  id                String    @id @default(uuid())
  clientName        String    @map("client_name")
  clientPhone       String?   @map("client_phone")
  clientEmail       String?   @map("client_email")
  referrerName      String    @map("referrer_name")
  referrerOrg       String?   @map("referrer_org") // hospital, LHIN, CCAC, physician
  referrerType      String    @default("external") @map("referrer_type") // internal, external, self
  serviceNeeded     String?   @map("service_needed")
  urgency           String    @default("routine") // routine, urgent, emergent
  clinicalNotes     String?   @map("clinical_notes")
  status            String    @default("pending") // pending, accepted, waitlisted, converted, declined
  convertedClientId String?   @map("converted_client_id")
  convertedAt       DateTime? @map("converted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  tenantId          String    @map("tenant_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("referrals")
}

model FamilyMember {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  name         String
  email        String?
  phone        String?
  relationship String // spouse, child, sibling, parent, guardian, other
  accessLevel  String   @default("view_only") @map("access_level") // view_only, care_updates, full
  linkedUserId String?  @map("linked_user_id") // optional link to User account
  isEmergency  Boolean  @default(false) @map("is_emergency")
  notifyVisits Boolean  @default(true) @map("notify_visits")
  notifyCare   Boolean  @default(true) @map("notify_care")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenantId     String   @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("family_members")
}

model PerformanceReview {
  id             String    @id @default(uuid())
  pswId          String    @map("psw_id")
  reviewerId     String    @map("reviewer_id")
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime  @map("period_end")
  overallRating  Float?    @map("overall_rating") // 1.0 - 5.0
  kpis           String? // { onTimeRate, satisfactionScore, incidentRate, completionRate }
  goals          String? // [{ description, status, dueDate }]
  strengths      String?
  improvements   String?
  notes          String?
  status         String    @default("draft") // draft, submitted, acknowledged
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tenantId       String    @map("tenant_id")

  psw      PswProfile @relation(fields: [pswId], references: [id])
  reviewer User       @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  tenant   Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([pswId])
  @@map("performance_reviews")
}

model WebhookEndpoint {
  id              String    @id @default(uuid())
  url             String
  events          String // visit.completed, incident.created, invoice.paid, etc.
  secret          String // HMAC signing secret
  status          String    @default("active") // active, paused, disabled
  lastDeliveredAt DateTime? @map("last_delivered_at")
  failureCount    Int       @default(0) @map("failure_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenantId        String    @map("tenant_id")

  deliveries WebhookDelivery[]
  tenant     Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  endpointId   String   @map("endpoint_id")
  event        String // e.g., visit.completed
  payload      String
  statusCode   Int?     @map("status_code")
  responseBody String?  @map("response_body")
  retryCount   Int      @default(0) @map("retry_count")
  deliveredAt  DateTime @default(now()) @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId])
  @@map("webhook_deliveries")
}

model IoTEvent {
  id         String   @id @default(uuid())
  deviceId   String   @map("device_id")
  deviceType String   @map("device_type")
  payload    String
  status     String   @default("processed")
  userId     String?  @map("user_id")
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@map("iot_events")
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("app_notifications")
}

model GamificationProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  careCoins      Int      @default(0) @map("care_coins")
  currentTier    String   @default("Bronze") @map("current_tier")
  lifetimePoints Int      @default(0) @map("lifetime_points")
  tenantId       String?  @map("tenant_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("gamification_profiles")
}

model AIInference {
  id              String   @id @default(uuid())
  modelName       String   @map("model_name") // e.g., lead_scorer, no_show_predictor
  targetId        String   @map("target_id") // e.g., leadId, visitId
  targetType      String   @map("target_type")
  confidenceScore Float    @map("confidence_score")
  predictionData  String   @map("prediction_data_json") // JSON string of the inference result
  tenantId        String?  @map("tenant_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([targetId, targetType])
  @@map("ai_inferences")
}

model CommunicationLog {
  id         String   @id @default(uuid())
  direction  String   @default("outbound") // inbound, outbound
  channel    String // sms, email, voice, social
  recipient  String?
  sender     String?
  subject    String?
  bodyText   String?  @map("body_text")
  status     String   @default("sent") // queued, sent, failed, delivered
  externalId String?  @map("external_id") // Twilio SID, SendGrid ID
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("communication_logs")
}
