model ClientTrendNode {
  id              String   @id @default(uuid())
  tenantId        String
  monthLabel      String
  revenueAmount   Float
  apptCount       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model ClientClinicNode {
  id              String   @id @default(uuid())
  tenantId        String
  clinicName      String
  starRating      Int
  revenueString   String
  rank            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model ClientDemographicNode {
  id              String   @id @default(uuid())
  tenantId        String
  cohortGroup     String
  percentage      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
