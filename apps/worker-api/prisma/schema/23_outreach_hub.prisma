model OutreachEventNode {
  id              String   @id @default(uuid())
  tenantId        String
  eventName       String
  location        String
  scheduledDate   DateTime
  status          String   // Upcoming, Completed, Active
  participantGoal Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model ParticipantMetricNode {
  id              String   @id @default(uuid())
  tenantId        String
  metricDate      String
  totalReached    Int
  engagementScore Float
  healthScreened  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model OutreachBudgetNode {
  id              String   @id @default(uuid())
  tenantId        String
  projectName     String
  allocatedFunds  Int
  fundsUsed       Int
  sponsor         String
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
