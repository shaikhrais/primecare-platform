model HealthNetRevenueNode {
  id              String   @id @default(uuid())
  tenantId        String
  quarterLabel    String
  revenueValue    Float
  grossMargin     Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model HealthNetEfficiencyNode {
  id              String   @id @default(uuid())
  tenantId        String
  clinicName      String
  efficiencyScore Float
  patientsSeen    Int
  waitTimesAvg    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model HealthNetNetworkNode {
  id              String   @id @default(uuid())
  tenantId        String
  regionName      String
  clinicCount     Int
  demographicCat  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
