model LocalMarketingAnalyticNode {
  id              String   @id @default(uuid())
  tenantId        String
  metricType      String
  value           Float
  growthYoY      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model LocalCampaignNode {
  id              String   @id @default(uuid())
  tenantId        String
  campaignName    String
  managerName     String
  roiFactor      Float
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model LocalContentNode {
  id              String   @id @default(uuid())
  tenantId        String
  assetTitle      String
  assetType       String
  deployedDate    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
