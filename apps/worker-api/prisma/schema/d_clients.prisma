// Domain: d_clients.prisma

// 
// 11_family_portal.prisma
// Extends the core data model to explicitly support Family App dashboard metrics

model FamilyAppointment {
  id          String   @id @default(uuid())
  title       String
  patientName String
  doctorName  String
  date        DateTime
  time        String
  location    String
  status      String   @default("PLANNED") // PLANNED, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FamilyCarePlanTask {
  id          String   @id @default(uuid())
  patientName String
  taskName    String
  category    String   @default("MEDICATION") // MEDICATION, VITALS, ACTIVITY
  timeSlot    String
  isCompleted Boolean  @default(false)
  completedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FamilyClinicalMessage {
  id         String   @id @default(uuid())
  threadId   String
  senderName String
  senderRole String // DOCTOR, NURSE, PSW, FAMILY
  content    String
  timestamp  DateTime @default(now())
  isRead     Boolean  @default(false)
}

// 
model Clinic {
  id              String    @id @default(uuid())
  name            String
  location        String
  patientVolume   Int
  efficiencyScore Float
  revenue         Float
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  patients        Patient[]
}

model Patient {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  age       Int
  gender    String
  status    String   @default("ACTIVE") // ACTIVE, DISCHARGED
  avatarUrl String?
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialRecord {
  id        String   @id @default(uuid())
  month     String // e.g. "Jan", "Feb"
  revenue   Float
  expenses  Float
  clinicId  String?
  createdAt DateTime @default(now())
}

// 
model ClientTrendNode {
  id            String   @id @default(uuid())
  tenantId      String
  monthLabel    String
  revenueAmount Float
  apptCount     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model ClientClinicNode {
  id            String   @id @default(uuid())
  tenantId      String
  clinicName    String
  starRating    Int
  revenueString String
  rank          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model ClientDemographicNode {
  id          String   @id @default(uuid())
  tenantId    String
  cohortGroup String
  percentage  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// 
model HealthNetRevenueNode {
  id           String   @id @default(uuid())
  tenantId     String
  quarterLabel String
  revenueValue Float
  grossMargin  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model HealthNetEfficiencyNode {
  id              String   @id @default(uuid())
  tenantId        String
  clinicName      String
  efficiencyScore Float
  patientsSeen    Int
  waitTimesAvg    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model HealthNetNetworkNode {
  id             String   @id @default(uuid())
  tenantId       String
  regionName     String
  clinicCount    Int
  demographicCat String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}
