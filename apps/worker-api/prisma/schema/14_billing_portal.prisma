model InvoiceRecord {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String   @unique
  patientName     String
  clinicLocation  String
  amount          Float
  status          String   // Paid, Pending, Overdue
  issueDate       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model InsuranceClaim {
  id              String   @id @default(uuid())
  tenantId        String
  claimCode       String   @unique
  patientName     String
  provider        String
  status          String   // Submission, Review, Reimbursed, Denied
  denialReason    String?
  amount          Float
  submissionDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model FinancialGoal {
  id              String   @id @default(uuid())
  tenantId        String
  month           Int
  year            Int
  label           String
  targetRevenue   Float
  actualRevenue   Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
