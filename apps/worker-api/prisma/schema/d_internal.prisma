// Domain: d_internal.prisma

// 
model InvoiceRecord {
  id             String   @id @default(uuid())
  tenantId       String
  invoiceId      String   @unique
  patientName    String
  clinicLocation String
  amount         Float
  status         String // Paid, Pending, Overdue
  issueDate      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model InsuranceClaim {
  id             String   @id @default(uuid())
  tenantId       String
  claimCode      String   @unique
  patientName    String
  provider       String
  status         String // Submission, Review, Reimbursed, Denied
  denialReason   String?
  amount         Float
  submissionDate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model FinancialGoal {
  id            String   @id @default(uuid())
  tenantId      String
  month         Int
  year          Int
  label         String
  targetRevenue Float
  actualRevenue Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// 
model PatientAdmissionNode {
  id            String   @id @default(uuid())
  tenantId      String
  patientName   String
  priority      String // Critical, High, Normal
  condition     String
  location      String
  attendingPhys String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model ClinicalShiftNode {
  id           String   @id @default(uuid())
  tenantId     String
  providerName String
  role         String // RN, RPN, PSW
  startTime    DateTime
  endTime      DateTime
  facility     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model MedicalAuditNode {
  id              String   @id @default(uuid())
  tenantId        String
  regionCode      String // NY, IL, CA
  survivalRate    Float
  readmissionRate Float
  averageWaitTime Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

// 
model OutreachEventNode {
  id              String   @id @default(uuid())
  tenantId        String
  eventName       String
  location        String
  scheduledDate   DateTime
  status          String // Upcoming, Completed, Active
  participantGoal Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model ParticipantMetricNode {
  id              String   @id @default(uuid())
  tenantId        String
  metricDate      String
  totalReached    Int
  engagementScore Float
  healthScreened  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model OutreachBudgetNode {
  id             String   @id @default(uuid())
  tenantId       String
  projectName    String
  allocatedFunds Int
  fundsUsed      Int
  sponsor        String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// 
model SchedulerTrendNode {
  id        String   @id @default(uuid())
  tenantId  String
  dayLabel  String
  apptCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SchedulerRosterNode {
  id           String   @id @default(uuid())
  tenantId     String
  providerName String
  specialty    String
  shiftTime    String
  isAvailable  Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model SchedulerFacilityNode {
  id            String   @id @default(uuid())
  tenantId      String
  facilityName  String
  occupancyRate Float
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model SystemEventLog {
  id           String   @id @default(uuid())
  eventName    String
  sourceDomain String
  tenantId     String?
  payload      Json     @default("{}")
  timestamp    DateTime @default(now())

  @@index([tenantId])
  @@index([eventName])
}
