model SupportAgentNode {
  id              String   @id @default(uuid())
  tenantId        String
  agentName       String
  shiftTime       String
  activeTickets   Int
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model TicketVolumeNode {
  id              String   @id @default(uuid())
  tenantId        String
  hourlyMark      String
  inboundCount    Int
  resolvedCount   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model ResolutionFeedbackNode {
  id              String   @id @default(uuid())
  tenantId        String
  patientName     String
  csatScore       Float
  feedbackText    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
