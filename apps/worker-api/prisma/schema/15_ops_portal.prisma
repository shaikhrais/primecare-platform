model FacilityNode {
  id              String   @id @default(uuid())
  tenantId        String
  facilityName    String
  location        String
  managerName     String
  status          String   // Operational, Review, Issue
  satisfaction    Float
  dailyVisits     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model StaffUtilization {
  id              String   @id @default(uuid())
  tenantId        String
  staffName       String
  role            String
  totalHours      Float
  clinicalHours   Float
  adminHours      Float
  status          String   // Optimized, Overworked, Underutilized
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model OpsIssueTicket {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  description     String
  facilityName    String
  severity        String   // Critical, High, Medium, Low
  status          String   // Reported, Dispatched, Resolved
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
