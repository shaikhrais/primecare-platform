// 11_family_portal.prisma
// Extends the core data model to explicitly support Family App dashboard metrics

model FamilyAppointment {
  id           String   @id @default(uuid())
  title        String
  patientName  String
  doctorName   String
  date         DateTime
  time         String
  location     String
  status       String   @default("PLANNED") // PLANNED, COMPLETED, CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FamilyCarePlanTask {
  id           String   @id @default(uuid())
  patientName  String
  taskName     String
  category     String   @default("MEDICATION") // MEDICATION, VITALS, ACTIVITY
  timeSlot     String
  isCompleted  Boolean  @default(false)
  completedBy  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FamilyClinicalMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderName   String
  senderRole   String   // DOCTOR, NURSE, PSW, FAMILY
  content      String
  timestamp    DateTime @default(now())
  isRead       Boolean  @default(false)
}
