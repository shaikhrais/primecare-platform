model LocalNetworkNode {
  id              String   @id @default(uuid())
  tenantId        String
  locationName    String
  occupancyRate   Float
  serverLoadScore Float
  staffActive     Int
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model LocalFinanceNode {
  id              String   @id @default(uuid())
  tenantId        String
  monthLabel      String
  grossRevenue    Float
  netMargin       Float
  growthYoY      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model LocalActivityNode {
  id              String   @id @default(uuid())
  tenantId        String
  eventTitle      String
  eventType       String
  eventTime       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
