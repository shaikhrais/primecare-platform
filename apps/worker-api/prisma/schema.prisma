// ==========================================
// FINANCIAL ENGINE MODULES (Bank-Level)
// ==========================================

model ChartOfAccount {
  id          String   @id @default(uuid())
  code        String   // e.g., '1000', '2000'
  name        String   // e.g., 'Cash', 'Accounts Receivable'
  type        String
  status      String   @default("active")
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  journalEntries JournalEntry[]

  @@unique([tenantId, code])
  @@map("financial_accounts")
}

model FinancialTransaction {
  id           String            @id @default(uuid())
  type         String            // INVOICE, PAYMENT, PAYROLL, EXPENSE
  referenceId  String?           @map("reference_id") // ID of linked document
  amount       Decimal
  currency     String            @default("CAD")
  status       String  @default("draft")
  tenantId     String            @map("tenant_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  journalEntries JournalEntry[]
  reconciliations FinancialReconciliation[]

  @@index([tenantId])
  @@index([referenceId])
  @@map("financial_transactions")
}

model JournalEntry {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  accountId     String   @map("account_id")
  debit         Decimal  @default(0)
  paidOutAmount   Decimal? @map("paid_out_amount")
  currency      String   @default("CAD")
  balanceBefore Decimal  @default(0) @map("balance_before")
  balanceAfter  Decimal  @default(0) @map("balance_after")
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])
  account     ChartOfAccount       @relation(fields: [accountId], references: [id])
  tenant      Tenant               @relation(fields: [tenantId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("financial_journal_entries")
}

model FinancialReconciliation {
  id                String   @id @default(uuid())
  transactionId     String   @map("transaction_id")
  bankTransactionId String?  @map("bank_transaction_id")
  status            String   @default("pending") // pending, matched, reconciled
  matchedAt         DateTime? @map("matched_at")
  tenantId          String   @map("tenant_id")

  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id])
  bankTransaction BankTransaction?    @relation(fields: [bankTransactionId], references: [id])
  tenant          Tenant               @relation(fields: [tenantId], references: [id])

  @@map("financial_reconciliations")
}

model BankTransaction {
  id          String   @id @default(uuid())
  bankDate    DateTime @map("bank_date")
  description String
  amount          Decimal
  currency    String   @default("CAD")
  externalRef String?  @map("external_ref")
  status      String   @default("unreconciled") // unreconciled, reconciled, ignored
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  reconciliations FinancialReconciliation[]

  @@map("financial_bank_transactions")
}





// ==========================================
// DOMAIN FEATURE EXTENSIONS (Phase 1)
// ==========================================

model EVVRecord {
  id                 String   @id @default(uuid())
  visitId            String   @map("visit_id")
  pswId              String   @map("psw_id")
  checkType          String   @map("check_type") // check_in, check_out
  lat                Float?
  lng                Float?
  accuracy           Float?
  verificationMethod String   @default("gps") @map("verification_method") // gps, pin, biometric
  status             String   @default("valid") // valid, exception, overridden
  overrideById       String?  @map("override_by_id")
  overrideReason     String?  @map("override_reason")
  rawData            String?    @map("raw_data")
  capturedAt         DateTime @default(now()) @map("captured_at")
  tenantId           String   @map("tenant_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([visitId])
  @@index([pswId])
  @@map("evv_records")
}

model ServiceAuthorization {
  id              String    @id @default(uuid())
