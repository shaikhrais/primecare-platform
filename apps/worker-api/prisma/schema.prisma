generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// PLATFORM MODULES (Global Infrastructure)
// ==========================================

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  phone              String?
  passwordHash       String?             @map("password_hash")
  osmId              String?             @unique @map("osm_id")
  status             String?             @default("active")
  resetToken         String?
  resetTokenExpiry   DateTime?
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  tenantId           String              @map("tenant_id")
  roles              String              @default("client")
  auditLogs          AuditLog[]
  blogPosts          BlogPost[]
  clientProfile      ClientProfile?
  DailyEntry         DailyEntry[]
  reportedIncidents  Incident[]          @relation("Reporter")
  sentMessages       Message[]
  verifiedDocs       PswDocument[]       @relation("VerifiedBy")
  pswProfile         PswProfile?
  reviewedTimesheets Timesheet[]         @relation("ReviewedBy")
  telehealthSessions TelehealthSession[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  VisitCheckEvent    VisitCheckEvent[]

  // RN Mastery Extensions
  carePlansAuthored     CarePlan[]           @relation("CarePlanAuthor")
  assessments           ClinicalAssessment[]
  medicationRecons      MedicationRecon[]
  supervisionLogs       SupervisionLog[]
  acknowledgedIncidents Incident[]           @relation("Acknowledger")
  performedAudits      TechnicalAudit[]    @relation("PerformedAudits")
  dailyAuditSignOffs   DailyAuditSignOff[]
  wellnessPulses       WellnessPulse[]
  devices              UserDevice[]
  systemEvents         SystemEvent[]
  performanceReviewsAuthored PerformanceReview[] @relation("ReviewAuthor")

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  status             String              @default("active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  bookings           Booking[]
  clientProfiles     ClientProfile[]
  dailyEntries       DailyEntry[]
  incidents          Incident[]
  invoices           Invoice[]
  messageThreads     MessageThread[]
  pswAvailability    PswAvailability[]
  pswProfiles        PswProfile[]
  services           Service[]
  shiftAssignments   ShiftAssignment[]
  timesheets         Timesheet[]
  staffTasks         StaffTask[]
  leads              Lead[]
  users              User[]
  checkEvents        VisitCheckEvent[]
  visits             Visit[]
  apiKeys            ApiKey[]
  feedbacks          Feedback[]
  carePlans          CarePlan[]
  trainingModules    TrainingModule[]
  surveys            Survey[]
  regions            Region[]
  clinicalRecords    ClinicalRecord[]
  fhirSyncLogs       FhirSyncLog[]
  aiRecommendations  AIRecommendation[]
  sentimentAnalyses  SentimentAnalysis[]
  securityThreats    SecurityThreat[]
  slas               TenantSLA[]
  telehealthSessions TelehealthSession[]
  patientAlerts      PatientAlert[]
  insuranceProviders InsuranceProvider[]
  visitMatches       VisitMatch[]
  waitlistEntries    WaitlistEntry[]
  claims             Claim[]
  prescriptions      Prescription[]
  branchStats        BranchStat[]
  complianceRecords  ComplianceRecord[]
  familyNotifications FamilyNotification[]
  careFeedbacks       CareFeedback[]
  technicalAudits     TechnicalAudit[]
  bookingRequests     BookingRequest[]
  dailyAuditSignOffs  DailyAuditSignOff[]
  wellnessPulses      WellnessPulse[]
  systemTouchpoints   SystemTouchpoint[]

  // Business Model Extensions
  businessNumber  String? @map("business_number")
  supportEmail    String? @map("support_email")
  logoUrl         String? @map("logo_url")
  taxSettings     String?   @map("tax_settings")
  brandingConfig  String?   @map("branding_config")
  stripeAccountId String? @map("stripe_account_id")
  onboardingStep  Int     @default(1) @map("onboarding_step")

  // Security & Sovereignty Extensions
  allowedVpnRanges   String @map("allowed_vpn_ranges")
  enforceVpn         Boolean  @default(false) @map("enforce_vpn")
  requireDeviceApproval Boolean @default(false) @map("require_device_approval")
  maxDevicesPerUser  Int      @default(5) @map("max_devices_per_user")

  // Runtime CORS Configuration
  corsAllowedOrigins String @map("cors_allowed_origins")
  corsAllowedMethods String @map("cors_allowed_methods")
  corsAllowedHeaders String @map("cors_allowed_headers")
  taxPercentage      Decimal? @map("tax_percentage")

  // Fractal SaaS Extensions
  parentTenantId        String?                @map("parent_tenant_id")
  parentTenant          Tenant?                @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants          Tenant[]               @relation("TenantHierarchy")
  franchises            Franchise[]            @relation("ResellerTenants")
  marketplaceListings   MarketplaceListing[]
  handovers             ShiftHandover[]
  availabilityOverrides AvailabilityOverride[]
  payouts               Payout[]
  clinicalAssessments   ClinicalAssessment[]
  medicationRecons      MedicationRecon[]
  supervisionLogs       SupervisionLog[]
  inventoryItems        InventoryItem[]
  purchaseOrders        PurchaseOrder[]
  systemEvents          SystemEvent[]

  // Financial Engine
  financialAccounts       ChartOfAccount[]
  financialTransactions    FinancialTransaction[]
  financialJournalEntries  JournalEntry[]
  financialReconciliations FinancialReconciliation[]
  bankTransactions        BankTransaction[]

  // Registry
  registries              Registry[]

  // Domain Feature Extensions
  evvRecords              EVVRecord[]
  serviceAuthorizations   ServiceAuthorization[]
  consentForms            ConsentForm[]
  mileageLogs             MileageLog[]
  referrals               Referral[]
  familyMembers           FamilyMember[]
  performanceReviews      PerformanceReview[]
  webhookEndpoints        WebhookEndpoint[]

  @@map("tenants")
}

model Registry {
  id          String   @id @default(uuid())
  key         String   // dot-path key e.g. "ADMIN_DASHBOARD.TITLE"
  value       String   // the actual text/content value
  category    String   // content, api, route, theme, button, interaction
  section     String?  // grouping: e.g. "dashboards", "nav", "operations"
  metadata    String?    // extra config, icon, color, etc.
  tenantId    String?  @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([key, tenantId])
  @@index([category])
  @@index([section])
  @@index([tenantId])
  @@map("registries")
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String
  status     String    @default("active")
  tenantId   String    @map("tenant_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

model ClientProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique @map("user_id")
  fullName           String               @map("full_name")
  dob                DateTime?
  addressLine1       String?              @map("address_line1")
  addressLine2       String?              @map("address_line2")
  city               String?
  province           String?
  postalCode         String?              @map("postal_code")
  lat                Float?
  lng                Float?
  emergencyName      String?              @map("emergency_contact_name")
  emergencyPhone     String?              @map("emergency_contact_phone")
  preferences        String?                @map("preferences_json")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tenantId           String               @map("tenant_id")
  bookings           Booking[]
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  DailyEntry         DailyEntry[]
  invoices           Invoice[]
  messageThreads     MessageThread[]
  visits             Visit[]
  feedbacks          Feedback[]
  franchise          Franchise?           @relation(fields: [franchiseId], references: [id])
  franchiseId        String?              @map("franchise_id")
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  telehealthSessions TelehealthSession[]
  vitalSigns         VitalSign[]
  patientAlerts      PatientAlert[]
  claims             Claim[]
  prescriptions      Prescription[]
  marEntries         MAR_Entry[]
  carePlans          CarePlan[]
  assessments        ClinicalAssessment[]
  medicationRecons   MedicationRecon[]
  waitlistEntries    WaitlistEntry[]
  familyNotifications FamilyNotification[]
  careFeedbacks       CareFeedback[]
  bookingRequests     BookingRequest[]
  serviceAuthorizations ServiceAuthorization[]
  consentForms         ConsentForm[]
  familyMembers        FamilyMember[]

  @@index([tenantId])
  @@map("client_profiles")
}

model PswProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique @map("user_id")
  fullName         String                 @map("full_name")
  bio              String?
  languages        String
  serviceAreas     String               @map("service_areas")
  availabilityString String?                  @map("availability_json")
  isApproved       Boolean                @default(false) @map("is_approved")
  approvedAt       DateTime?              @map("approved_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  tenantId         String                 @map("tenant_id")
  address          String?
  avatarUrl        String?                @map("avatar_url")
  skills           String
  messageThreads   MessageThread[]        @relation("PswToThreads")
  availability     PswAvailability[]      @relation("PswToAvailability")
  documents        PswDocument[]          @relation("PswToDocuments")
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  user             User                   @relation(fields: [userId], references: [id])
  assignments      ShiftAssignment[]      @relation("PswToAssignments")
  timesheets       Timesheet[]            @relation("PswToTimesheets")
  checkEvents      VisitCheckEvent[]      @relation("PswToCheckEvents")
  checklists       VisitChecklist[]       @relation("PswToChecklists")
  notes            VisitNote[]            @relation("PswToNotes")
  assignedVisits   Visit[]                @relation("PswToVisits")
  handovers        ShiftHandover[]
  overrides        AvailabilityOverride[]
  payouts          Payout[]
  fleetStatus      FleetStatus?
  supervisionLogs  SupervisionLog[]
  matches          VisitMatch[]           @relation("VisitMatches")
  mileageLogs      MileageLog[]
  performanceReviews PerformanceReview[]

  @@index([tenantId])
  @@map("psw_profiles")
}

model Visit {
  id                  String            @id @default(uuid())
  clientId            String            @map("client_id")
  serviceId           String            @map("service_id")
  requestedStartAt    DateTime          @map("requested_start_at")
  durationMinutes     Int               @map("duration_minutes")
  status              String?      @default("requested")
  assignedPswId       String?           @map("assigned_psw_id")
  serviceAddressLine1 String?           @map("service_address_line1")
  serviceAddressLine2 String?           @map("service_address_line2")
  serviceCity         String?           @map("service_city")
  serviceProvince     String?           @map("service_province")
  servicePostalCode   String?           @map("service_postal_code")
  serviceLat          Float?            @map("service_lat")
  serviceLng          Float?            @map("service_lng")
  clientNotes         String?           @map("client_notes")
  coordinatorNotes    String?           @map("coordinator_notes")
  cancellationReason  String?           @map("cancellation_reason")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  tenantId            String            @map("tenant_id")
  bookingId           String?           @map("booking_id")
  crisisMode          Boolean?          @default(false) @map("crisis_mode")
  priority            String?           @default("normal")
  requiredSkills      String          @map("required_skills")
  isSurgeActive       Boolean?          @default(false) @map("is_surge_active")
  surgeMultiplier     Float?            @default(1.0) @map("surge_multiplier")
  DailyEntry          DailyEntry[]
  incidents           Incident[]
  assignments         ShiftAssignment[]
  timesheetItems      TimesheetItem[]
  checkEvents         VisitCheckEvent[]
  checklists          VisitChecklist[]
  notes               VisitNote[]
  feedbacks           Feedback[]
  matches             VisitMatch[]
  psw                 PswProfile?       @relation("PswToVisits", fields: [assignedPswId], references: [id])
  booking             Booking?          @relation(fields: [bookingId], references: [id])
  client              ClientProfile     @relation(fields: [clientId], references: [id])
  service             Service           @relation(fields: [serviceId], references: [id])
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  handovers           ShiftHandover[]
  careFeedbacks       CareFeedback[]
  dailyAuditSignOff   DailyAuditSignOff?

  @@index([tenantId])
  @@map("visits")
}

model Service {
  id                 String          @id @default(uuid())
  name               String
  slug               String          @unique
  description        String?
  baseRateHourly     Decimal?        @map("base_rate_hourly")
  providerRateHourly Decimal?        @map("provider_rate_hourly")
  isActive           Boolean?        @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  tenantId           String          @map("tenant_id")
  isFeatured         Boolean         @default(false) @map("is_featured")
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  visits             Visit[]
  waitlistEntries    WaitlistEntry[]

  @@index([tenantId])
  @@map("services")
}

model VisitCheckEvent {
  id                String      @id @default(uuid())
  visitId           String      @map("visit_id")
  pswId             String      @map("psw_id")
  eventType         String   @map("event_type")
  lat               Float?
  lng               Float?
  accuracyM         Float?      @map("accuracy_m")
  computedDistanceM Float?      @map("computed_distance_m")
  deviceTimeIso     DateTime?   @map("device_time_iso")
  serverTime        DateTime?   @default(now()) @map("server_time")
  result            String
  rejectReason      String?     @map("reject_reason")
  isOverride        Boolean?    @default(false) @map("is_override")
  overrideByUserId  String?     @map("override_by_user_id")
  overrideReason    String?     @map("override_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  tenantId          String      @map("tenant_id")
  overriddenBy      User?       @relation(fields: [overrideByUserId], references: [id])
  pswProfile        PswProfile  @relation("PswToCheckEvents", fields: [pswId], references: [id])
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  visit             Visit       @relation(fields: [visitId], references: [id])

  @@map("visit_check_events")
}

model VisitNote {
  id        String     @id @default(uuid())
  visitId   String     @map("visit_id")
  pswId     String     @map("psw_id")
  noteText  String     @map("note_text")
  createdAt DateTime   @default(now()) @map("created_at")
  psw       PswProfile @relation("PswToNotes", fields: [pswId], references: [id])
  visit     Visit      @relation(fields: [visitId], references: [id])

  @@map("visit_notes")
}

model VisitChecklist {
  id            String     @id @default(uuid())
  visitId       String     @map("visit_id")
  pswId         String     @map("psw_id")
  checklistString String       @map("checklist_json")
  createdAt     DateTime   @default(now()) @map("created_at")
  psw           PswProfile @relation("PswToChecklists", fields: [pswId], references: [id])
  visit         Visit      @relation(fields: [visitId], references: [id])

  @@map("visit_checklists")
}

model Incident {
  id              String          @id @default(uuid())
  visitId         String?         @map("visit_id")
  reporterUserId  String          @map("reporter_user_id")
  type            String
  description     String
  status          String? @default("open")
  resolutionNotes String?         @map("resolution_notes")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  tenantId        String          @map("tenant_id")
  acknowledgedAt  DateTime?       @map("acknowledged_at")
  acknowledgedBy  String?         @map("acknowledged_by")
  acknowledger    User?           @relation("Acknowledger", fields: [acknowledgedBy], references: [id])
  reporter        User            @relation("Reporter", fields: [reporterUserId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  visit           Visit?          @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@map("incidents")
}

model Timesheet {
  id           String           @id @default(uuid())
  pswId        String           @map("psw_id")
  weekId       String           @map("week_id")
  totalMinutes Int?             @default(0) @map("total_minutes")
  status       String? @default("draft")
  submittedAt  DateTime?        @map("submitted_at")
  reviewedBy   String?          @map("reviewed_by")
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  tenantId     String           @map("tenant_id")
  items        TimesheetItem[]
  psw          PswProfile       @relation("PswToTimesheets", fields: [pswId], references: [id])
  reviewer     User?            @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("timesheets")
}

model TimesheetItem {
  id          String    @id @default(uuid())
  timesheetId String    @map("timesheet_id")
  visitId     String    @map("visit_id")
  minutes     Int
  createdAt   DateTime  @default(now()) @map("created_at")
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
  visit       Visit     @relation(fields: [visitId], references: [id])

  @@map("timesheet_items")
}

model Invoice {
  id              String         @id @default(uuid())
  clientId        String         @map("client_id")
  status          String? @default("draft")
  currency        String?        @default("CAD")
  subtotal        Decimal?
  tax             Decimal?
  total           Decimal?
  stripeInvoiceId String?        @map("stripe_invoice_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  tenantId        String         @map("tenant_id")
  client          ClientProfile  @relation(fields: [clientId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  payments        Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Payment {
  id                    String   @id @default(uuid())
  invoiceId             String   @map("invoice_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amount                Decimal?
  status                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  invoice               Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model MessageThread {
  id         String         @id @default(uuid())
  threadType String         @map("thread_type")
  clientId   String?        @map("client_id")
  pswId      String?        @map("psw_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  tenantId   String         @map("tenant_id")
  messages   Message[]
  client     ClientProfile? @relation(fields: [clientId], references: [id])
  psw        PswProfile?    @relation("PswToThreads", fields: [pswId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("messages_threads")
}

model Message {
  id           String        @id @default(uuid())
  threadId     String        @map("thread_id")
  senderUserId String        @map("sender_user_id")
  bodyText     String        @map("body_text")
  createdAt    DateTime      @default(now()) @map("created_at")
  sender       User          @relation(fields: [senderUserId], references: [id])
  thread       MessageThread @relation(fields: [threadId], references: [id])

  @@map("messages")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadataString String?    @map("metadata_json")
  deviceId     String?  @map("device_id")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  tenantId     String   @map("tenant_id")
  actor        User?    @relation(fields: [actorUserId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@map("audit_logs")
}

model SystemEvent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  operation    String   // CREATE, UPDATE, DELETE
  modelName    String   @map("model_name")
  entityId     String?  @map("entity_id")
  payload      String?
  previousData String?    @map("previous_data")
  actorUserId  String?  @map("actor_user_id")
  deviceId     String?  @map("device_id")
  ipAddress    String?  @map("ip_address")
  checksum     String   @default("")
  previousChecksum String? @map("previous_checksum")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  actor    User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([modelName, entityId])
  @@index([createdAt])
  @@map("system_events")
}

model Lead {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String
  phone             String?
  message           String?
  source            String
  status            String?   @default("new")
  serviceInterest   String   @map("service_interest")
  notes             String?
  convertedToUserId String?   @map("converted_to_user_id")
  conversionDate    DateTime? @map("conversion_date")
  tenantId          String?   @map("tenant_id")
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("leads")
}

model Booking {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  branchId       String?       @map("branch_id")
  startAt        DateTime      @map("start_at")
  endAt          DateTime      @map("end_at")
  serviceType    String        @map("service_type")
  priority       String        @default("normal")
  notes          String?
  status         String        @default("pending")
  recurrenceRule String?         @map("recurrence_rule")
  tenantId       String        @map("tenant_id")
  client         ClientProfile @relation(fields: [clientId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  visits         Visit[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("bookings")
}

model PswAvailability {
  id        String     @id @default(uuid())
  pswId     String     @map("psw_id")
  dayOfWeek Int        @map("day_of_week")
  startTime String     @map("start_time")
  endTime   String     @map("end_time")
  tenantId  String     @map("tenant_id")
  psw       PswProfile @relation("PswToAvailability", fields: [pswId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])

  @@map("psw_availability")
}

model ShiftAssignment {
  id         String           @id @default(uuid())
  visitId    String           @map("visit_id")
  pswId      String           @map("psw_id")
  status     String @default("offered")
  score      Float?
  assignedAt DateTime         @default(now()) @map("assigned_at")
  tenantId   String           @map("tenant_id")
  psw        PswProfile       @relation("PswToAssignments", fields: [pswId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  visit      Visit            @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("shift_assignments")
}

model BlogPost {
  id                String    @id @default(uuid())
  title             String
  slug              String    @unique
  excerpt           String?
  contentHtml       String?   @map("content_html")
  status            String?   @default("draft")
  publishedAt       DateTime? @map("published_at")
  authorUserId      String?   @map("author_user_id")
