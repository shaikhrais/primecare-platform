  serviceId       String?   @map("service_id")
  fundingSource   String    @map("funding_source") // ohip, private, insurance, lhin
  authorizedHours Float     @map("authorized_hours")
  usedHours       Float     @default(0) @map("used_hours")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  status          String    @default("active") // active, expired, exhausted, suspended
  authCode        String?   @map("auth_code")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenantId        String    @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("service_authorizations")
}

model ConsentForm {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  formType         String    @map("form_type") // service_agreement, phipa_consent, dnr, hipaa, general
  status           String    @default("pending") // pending, signed, expired, revoked
  signatureDataUrl String?   @map("signature_data_url")
  signedAt         DateTime? @map("signed_at")
  expiresAt        DateTime? @map("expires_at")
  documentKey      String?   @map("document_key") // R2 storage key for PDF
