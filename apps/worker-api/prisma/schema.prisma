  accessLevel  String   @default("view_only") @map("access_level") // view_only, care_updates, full
  linkedUserId String?  @map("linked_user_id") // optional link to User account
  isEmergency  Boolean  @default(false) @map("is_emergency")
  notifyVisits Boolean  @default(true) @map("notify_visits")
  notifyCare   Boolean  @default(true) @map("notify_care")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenantId     String   @map("tenant_id")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("family_members")
}

model PerformanceReview {
  id            String    @id @default(uuid())
  pswId         String    @map("psw_id")
  reviewerId    String    @map("reviewer_id")
  periodStart   DateTime  @map("period_start")
  periodEnd     DateTime  @map("period_end")
  overallRating Float?    @map("overall_rating") // 1.0 - 5.0
  kpis          String?     // { onTimeRate, satisfactionScore, incidentRate, completionRate }
  goals         String?     // [{ description, status, dueDate }]
  strengths     String?
  improvements  String?
  notes         String?
  status        String    @default("draft") // draft, submitted, acknowledged
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenantId      String    @map("tenant_id")

  psw      PswProfile @relation(fields: [pswId], references: [id])
  reviewer User       @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  tenant   Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([pswId])
  @@map("performance_reviews")
}

model WebhookEndpoint {
  id            String   @id @default(uuid())
  url           String
  events        String // visit.completed, incident.created, invoice.paid, etc.
  secret        String   // HMAC signing secret
  status        String   @default("active") // active, paused, disabled
  lastDeliveredAt DateTime? @map("last_delivered_at")
  failureCount  Int      @default(0) @map("failure_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenantId      String   @map("tenant_id")

  deliveries WebhookDelivery[]
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  endpointId   String   @map("endpoint_id")
  event        String   // e.g., visit.completed
  payload      String
  statusCode   Int?     @map("status_code")
  responseBody String?  @map("response_body")
  retryCount   Int      @default(0) @map("retry_count")
  deliveredAt  DateTime @default(now()) @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId])
  @@map("webhook_deliveries")
}
