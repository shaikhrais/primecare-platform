{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare API Execution Status",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/governance/api-execution-status": {
      "get": {
        "operationId": "governance_api_execution_status",
        "summary": "Read API verification and contract gaps",
        "description": "Existing inventory authority, active explicit bearer session and tenant match required. Recorded governance evidence only. Active/healthy declarations do not prove executable APIs. Unit-tested records do not imply PostgreSQL or production verification. Filters and paging share governance API conventions.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "app",
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          },
          {
            "in": "query",
            "name": "role",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "in": "query",
            "name": "screen",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded API execution status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination",
                    "source"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "api",
                          "declaredImplementation",
                          "verificationState",
                          "missingContractFields",
                          "recordedUnitStatus",
                          "productionVerified",
                          "postgresVerified",
                          "management"
                        ],
                        "properties": {
                          "management": {
                            "type": "object",
                            "required": [
                              "implementation",
                              "protection",
                              "readiness",
                              "maintenance",
                              "evidenceScope"
                            ],
                            "properties": {
                              "implementation": {
                                "type": "string",
                                "enum": [
                                  "blocked",
                                  "declared_implemented",
                                  "partial",
                                  "unknown"
                                ]
                              },
                              "protection": {
                                "type": "string",
                                "enum": [
                                  "permission_metadata_missing",
                                  "unverified",
                                  "verified_access_policy"
                                ]
                              },
                              "readiness": {
                                "type": "string",
                                "enum": [
                                  "blocked",
                                  "maintenance",
                                  "unverified",
                                  "ready"
                                ]
                              },
                              "maintenance": {
                                "type": "string",
                                "enum": [
                                  "recorded_maintenance",
                                  "unknown",
                                  "scheduled_maintenance",
                                  "active_maintenance"
                                ]
                              },
                              "evidenceScope": {
                                "enum": [
                                  "registered_operation_metadata",
                                  "reviewed_release_receipt"
                                ]
                              },
                              "maintenanceWindow": {
                                "type": "object",
                                "required": [
                                  "status",
                                  "startsAt",
                                  "endsAt",
                                  "reason"
                                ],
                                "properties": {
                                  "status": {
                                    "enum": [
                                      "scheduled",
                                      "active"
                                    ]
                                  },
                                  "startsAt": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "endsAt": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "reason": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  }
                                },
                                "additionalProperties": false
                              },
                              "verificationEvidence": {
                                "type": "object",
                                "required": [
                                  "releaseId",
                                  "verifiedAt",
                                  "expiresAt",
                                  "runId"
                                ],
                                "properties": {
                                  "releaseId": {
                                    "type": "string"
                                  },
                                  "verifiedAt": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "expiresAt": {
                                    "type": "string",
                                    "format": "date-time"
                                  },
                                  "runId": {
                                    "type": "string",
                                    "pattern": "^[1-9][0-9]{0,19}$"
                                  }
                                },
                                "additionalProperties": false
                              }
                            },
                            "additionalProperties": false
                          },
                          "routingEvidence": {
                            "description": "Historical anonymous, offline routing observation for this exact declaration. Null means no matching observation.",
                            "type": [
                              "object",
                              "null"
                            ],
                            "required": [
                              "status",
                              "sourceCommit",
                              "scope"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "status": {
                                "type": "integer",
                                "minimum": 100,
                                "maximum": 599
                              },
                              "sourceCommit": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{40}$"
                              },
                              "scope": {
                                "const": "offline_unauthenticated_catalog_probe"
                              }
                            }
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object"
                    },
                    "source": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "No active session"
          },
          "403": {
            "description": "Inventory authority or tenant mismatch"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
