{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Owned Thread and Family-Link Summaries",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/client/conversation-threads/summary": {
      "get": {
        "operationId": "client_own_messages_threads_status_summary",
        "summary": "Count owned records by registered metadata key",
        "description": "Active explicit bearer, unique owned client profile and matching tenant required. SQL binds client_id and tenant_id. Counts group stored thread_type or relationship labels only; pagination total counts groups. No message content, family contact details, provider or linked user IDs, access levels or notification flags. Labels do not grant access to messages, consent, proxy or emergency authority. Read only, no role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "thread_type",
                          "count"
                        ],
                        "properties": {
                          "thread_type": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "thread_type": "pending",
                      "count": 2
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Owned profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable"
          }
        }
      }
    },
    "/v1/client/family-links/summary": {
      "get": {
        "operationId": "client_own_family_members_status_summary",
        "summary": "Count owned records by registered metadata key",
        "description": "Active explicit bearer, unique owned client profile and matching tenant required. SQL binds client_id and tenant_id. Counts group stored thread_type or relationship labels only; pagination total counts groups. No message content, family contact details, provider or linked user IDs, access levels or notification flags. Labels do not grant access to messages, consent, proxy or emergency authority. Read only, no role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "relationship",
                          "count"
                        ],
                        "properties": {
                          "relationship": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "relationship": "pending",
                      "count": 2
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Owned profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
