{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Client Bookings Batch 9",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/client/bookings": {
      "get": {
        "operationId": "client_self_bookings",
        "summary": "List own bookings",
        "description": "Active explicit bearer session. client_profiles.user_id must match the actor and tenant_id must match the actor tenant. No arbitrary clientId/userId/tenant overrides. Booking queries additionally check booking tenant and owner profile. Missing profile returns 404; conflicting tenant header returns 403. No clinical details or payment processor identifiers are returned. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "bookings",
                    "pagination"
                  ],
                  "properties": {
                    "bookings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "start_at",
                          "end_at",
                          "service_type",
                          "priority",
                          "status",
                          "recurrence_rule"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "start_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "end_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "service_type": {
                            "type": "string"
                          },
                          "priority": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "recurrence_rule": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own client profile or booking absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable or schema dependency missing"
          }
        }
      }
    },
    "/v1/client/bookings/{bookingId}": {
      "get": {
        "operationId": "client_self_booking_detail",
        "summary": "Read own booking",
        "description": "Active explicit bearer session. client_profiles.user_id must match the actor and tenant_id must match the actor tenant. No arbitrary clientId/userId/tenant overrides. Booking queries additionally check booking tenant and owner profile. Missing profile returns 404; conflicting tenant header returns 403. No clinical details or payment processor identifiers are returned. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "bookingId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "booking"
                  ],
                  "properties": {
                    "booking": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "start_at",
                        "end_at",
                        "service_type",
                        "priority",
                        "status",
                        "recurrence_rule"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "start_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "end_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "service_type": {
                          "type": "string"
                        },
                        "priority": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "recurrence_rule": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own client profile or booking absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable or schema dependency missing"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
