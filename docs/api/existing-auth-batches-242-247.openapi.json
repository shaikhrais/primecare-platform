            "description": "Existing authority or tenant policy rejects request"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Source unavailable"
          },
          "409": {
            "description": "Account cannot be created"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
