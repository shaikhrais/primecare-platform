    "/v1/auth/register": {
      "post": {
        "operationId": "existingAuthBatch245",
        "description": "Create a tenant account under the existing CEO or HR role assignment policy. Explicit bearer required.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Successful existing handler response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
