    "/v1/admin/users": {
      "post": {
        "operationId": "existingAuthBatch242",
        "description": "Manage another account in the active CEO tenant; revoke target sessions and audit the change.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful existing handler response",
