                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "assignableRoles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
