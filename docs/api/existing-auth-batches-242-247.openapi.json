    "/v1/user/change-password": {
      "post": {
        "operationId": "existingAuthBatch246",
        "description": "Change own password after current-password verification; revoke all sessions and password resets.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful existing handler response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reauthenticationRequired"
                  ],
                  "properties": {
                    "status": {
                      "const": "password_changed"
                    },
                    "reauthenticationRequired": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid session or current credentials"
          },
          "403": {
            "description": "Existing authority or tenant policy rejects request"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Source unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "description": "At most 72 UTF-8 bytes; must match the current password."
                  },
                  "newPassword": {
                    "type": "string",
                    "description": "At least 12 JavaScript UTF-16 code units and at most 72 UTF-8 bytes; validated by the handler."
                  }
                }
              }
            }
          }
        }
      }
    }
