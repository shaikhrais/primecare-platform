{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Provider Review and Availability Summaries",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/availability-overrides/summary": {
      "get": {
        "operationId": "provider_own_provider_availability_overrides_summary",
        "summary": "Read own provider availability overrides summary",
        "description": "Count stored statuses or availability flags under a unique actor-owned ProviderProfile and matching non-null tenant. Every record query binds provider_id to that profile ID and tenant_id to actor tenant; reviewer User ownership is distinct and does not grant these reads. Return registered stored status or boolean is_available and count only. Pagination total counts groups; boolean false sorts before true. Review contents, reviewer IDs, ratings, goals, availability dates/times and other providers are excluded. Status counts do not establish performance outcomes; availability flags do not establish bookability or override visit schedules. Active explicit bearer, no-store read-only repeatable-read snapshots, bounded paging and source limits apply. No grants or mutations.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "is_available",
                          "count"
                        ],
                        "properties": {
                          "is_available": {
                            "type": "boolean"
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "is_available": false,
                      "count": 1
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
    "/v1/provider/performance-reviews/summary": {
      "get": {
        "operationId": "provider_own_performance_reviews_summary",
        "summary": "Read own performance reviews summary",
        "description": "Count stored statuses or availability flags under a unique actor-owned ProviderProfile and matching non-null tenant. Every record query binds provider_id to that profile ID and tenant_id to actor tenant; reviewer User ownership is distinct and does not grant these reads. Return registered stored status or boolean is_available and count only. Pagination total counts groups; boolean false sorts before true. Review contents, reviewer IDs, ratings, goals, availability dates/times and other providers are excluded. Status counts do not establish performance outcomes; availability flags do not establish bookability or override visit schedules. Active explicit bearer, no-store read-only repeatable-read snapshots, bounded paging and source limits apply. No grants or mutations.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "status": "stored",
                      "count": 1
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
