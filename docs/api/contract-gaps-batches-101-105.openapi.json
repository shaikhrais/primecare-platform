{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Registered API Contract Gaps",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/governance/api-verification-summary": {
      "get": {
        "operationId": "governance_api_verification_summary",
        "summary": "Count registered operations by recorded verification state after scope filters.",
        "description": "Existing inventory authority, active explicit bearer and matching non-null tenant required. Static registered governance metadata only; this does not read tenant business records or infer permissions from reporting hierarchy. Permission gaps mean an absent registered key; schema gaps mean a missing or non-object JSON declaration, not full schema validation. Screen gaps mean no registered association, not proof of a missing UI. Recorded unit-fixture status is not database or production verification. For verification summary, exact app/role/screen and case-insensitive search filters apply to operation rows before aggregation, then limit/offset page the verification-state groups. Gap lists apply the gap predicate before filters and paging. Empty filters return empty data. No writes, new grants or readiness promotion.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "app",
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          },
          {
            "in": "query",
            "name": "role",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "in": "query",
            "name": "screen",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registered contract gaps or scoped recorded verification groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "pagination",
                    "source"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "verificationState",
                          "operations",
                          "contractGaps",
                          "postgresVerified",
                          "productionVerified"
                        ],
                        "properties": {
                          "verificationState": {
                            "enum": [
                              "blocked",
                              "unit_fixtures_recorded",
                              "verification_pending"
                            ]
                          },
                          "operations": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "contractGaps": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "permission",
                              "requestSchema",
                              "responseSchema",
                              "screenLink"
                            ],
                            "properties": {
                              "permission": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "requestSchema": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "responseSchema": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "screenLink": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          "postgresVerified": {
                            "const": false
                          },
                          "productionVerified": {
                            "const": false
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    },
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "catalogVersion",
                        "evidenceType"
                      ],
                      "properties": {
                        "catalogVersion": {
                          "type": "string"
                        },
                        "evidenceType": {
                          "const": "registered_governance"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "No active bearer"
          },
          "403": {
            "description": "Missing inventory authority or tenant mismatch"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    },
