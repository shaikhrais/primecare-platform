{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Provider Document Metadata Batch 13",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/documents": {
      "get": {
        "operationId": "provider_self_documents",
        "summary": "List own credential document metadata",
        "description": "Active explicit bearer session. provider_profiles.user_id must match the actor and tenant_id must match the actor tenant. No arbitrary providerId/userId/tenant overrides. Document queries join provider_profiles, requiring provider_id, actor user_id and profile tenant_id to match. Documents have no tenant column. Missing profile returns 404; conflicting tenant header returns 403. Metadata only: storage keys and verifier identities are excluded. This endpoint does not download, upload or verify files. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "documents",
                    "pagination"
                  ],
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "doc_type",
                          "status",
                          "expiry_date",
                          "verified_at",
                          "created_at",
                          "updated_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "doc_type": {
                            "type": "string"
                          },
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "expiry_date": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "verified_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own provider profile or document absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable or schema dependency missing"
          }
        }
      }
    },
    "/v1/provider/documents/{documentId}": {
      "get": {
        "operationId": "provider_self_document_detail",
        "summary": "Read own credential document metadata",
        "description": "Active explicit bearer session. provider_profiles.user_id must match the actor and tenant_id must match the actor tenant. No arbitrary providerId/userId/tenant overrides. Document queries join provider_profiles, requiring provider_id, actor user_id and profile tenant_id to match. Documents have no tenant column. Missing profile returns 404; conflicting tenant header returns 403. Metadata only: storage keys and verifier identities are excluded. This endpoint does not download, upload or verify files. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "document"
                  ],
                  "properties": {
                    "document": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "doc_type",
                        "status",
                        "expiry_date",
                        "verified_at",
                        "created_at",
                        "updated_at"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "doc_type": {
                          "type": "string"
                        },
                        "status": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "expiry_date": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "verified_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own provider profile or document absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable or schema dependency missing"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
