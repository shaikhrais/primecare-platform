              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "consents",
                    "pagination"
                  ],
                  "properties": {
                    "consents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "form_type",
                          "status",
                          "signed_at",
                          "expires_at",
                          "template_version",
                          "created_at",
                          "updated_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "form_type": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "signed_at": {
