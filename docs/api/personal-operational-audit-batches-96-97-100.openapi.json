{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Operational Audit Summaries and Bootstrap Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/audit-signoff-records/summary": {
      "get": {
        "operationId": "auth_own_daily_audit_signoffs_summary",
        "summary": "Read own daily audit signoffs summary",
        "description": "Count your own stored technical-audit or daily-audit-signoff statuses. Bind active bearer actor User ID through performed_by_id or rn_id and matching non-null tenant in every query. Exclude null/foreign owners and tenants. Return stored status and count only, with bounded group paging; total counts groups. Clinical comments, visit/patient IDs, summaries, issue counts and details are excluded. Counts do not prove compliance, successful audits or completed care. Read-only repeatable-read snapshots, no-store, source limits and sanitized errors; no role grants or writes.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "status": "stored",
                      "count": 1
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
