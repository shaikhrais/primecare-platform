          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
    "/v1/auth/me/bootstrap-record": {
      "get": {
        "operationId": "auth_own_auth_bootstrap_audit_singleton",
        "summary": "Read own auth bootstrap audit singleton",
        "description": "Read only your recorded bootstrap creation timestamp. The existing auth_bootstrap_audit primary key is user_id. Every query binds active bearer actor User ID and the recorded matching non-null tenant. No record returns 404; malformed or duplicate data returns 503. The source, user ID and tenant ID are excluded. A timestamp is historical audit metadata and does not establish current CEO privileges, account creation method or authorization. No query filters, writes or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "bootstrap"
                  ],
                  "properties": {
                    "bootstrap": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "created_at"
                      ],
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "bootstrap": {
                    "created_at": "2026-01-01T12:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
