{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Client Family Notification Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/client/family-notification-records": {
      "get": {
        "operationId": "client_own_family_notifications_list",
        "summary": "Read owned family notifications list",
        "description": "Read only family-notification metadata directly linked to the active actor-owned ClientProfile and tenant. Every record query binds client_id and tenant_id; exactly one owned profile is required. Project only ID, stored notification type, boolean read flag and creation timestamp. Message text is excluded. These client-owned reads grant no family proxy, linked-family-user or conversation access. Stored read flags do not prove delivery or acknowledgement. Bounded stable paging, exact owned detail, read-only snapshots, no-store and source limits; no mutations or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected owned metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "notifications",
                    "pagination"
                  ],
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "type",
                          "is_read",
                          "created_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "is_read": {
                            "type": "boolean"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "notifications": [
                    {
                      "id": "record-id",
                      "type": "stored",
                      "is_read": "stored",
                      "created_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Profile or record absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable"
          }
        }
      }
    },
    "/v1/client/family-notification-records/{recordId}": {
      "get": {
        "operationId": "client_own_family_notifications_detail",
        "summary": "Read owned family notifications record",
        "description": "Read only family-notification metadata directly linked to the active actor-owned ClientProfile and tenant. Every record query binds client_id and tenant_id; exactly one owned profile is required. Project only ID, stored notification type, boolean read flag and creation timestamp. Message text is excluded. These client-owned reads grant no family proxy, linked-family-user or conversation access. Stored read flags do not prove delivery or acknowledgement. Bounded stable paging, exact owned detail, read-only snapshots, no-store and source limits; no mutations or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "recordId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected owned metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "notification"
                  ],
                  "properties": {
                    "notification": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "type",
                        "is_read",
                        "created_at"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "is_read": {
                          "type": "boolean"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "notification": {
                    "id": "record-id",
                    "type": "stored",
                    "is_read": "stored",
                    "created_at": "2026-01-01T12:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Profile or record absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
