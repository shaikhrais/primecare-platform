{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Provider Work Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/shift-assignment-records": {
      "get": {
        "operationId": "provider_own_shift_assignments_list",
        "summary": "Read own shift assignments list",
        "description": "Read own ProviderProfile assignment, handover or authored note/checklist metadata only. An active explicit bearer, matching non-null tenant and unique actor-owned ProviderProfile are required. Assignments/handovers bind provider_id and tenant_id in every query. Authored notes/checklists have no tenant column: every query joins the current owning ProviderProfile and binds its provider ID, tenant and actor User. This is current profile authorship scope, not historical visit tenant or present visit assignment authority. Return registered IDs, stored assignment status and timestamps only; exclude visit/client IDs, scores, note/checklist contents, safety concerns and supplies. No clinical access, offers accepted, visit readiness or completed care is inferred. Bounded paging/exact owned detail, no-store, read-only repeatable-read and source limits. No grants or mutations.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "assignments",
                    "pagination"
                  ],
                  "properties": {
                    "assignments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "status",
                          "assigned_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "assigned_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "assignments": [
                    {
                      "id": "record-id",
                      "status": "stored",
                      "assigned_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
