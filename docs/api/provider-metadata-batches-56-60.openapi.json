{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Mileage, Payout and Review Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/mileage-logs": {
      "get": {
        "operationId": "provider_own_mileage_logs_list",
        "summary": "Read own mileage logs list",
        "description": "Active explicit bearer, matching non-null tenant and unique actor-owned provider profile required; every query binds provider_id and tenant_id. Mileage exposes recorded distance/time/status without addresses, visit IDs, reimbursement rates or amounts. Payouts expose metadata only, excluding amounts and notes; stored currency/status does not confirm payment receipt. Performance reviews expose period/status/acknowledgement metadata only, excluding ratings, reviewer IDs, goals and review text. Acknowledgement does not imply agreement. Stored values do not establish eligibility, approval or competence. Read only, no role grants; summary totals count groups, not records.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "logs",
                    "pagination"
                  ],
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "date",
                          "distance_km",
                          "travel_minutes",
                          "status",
                          "created_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
                          },
                          "date": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "distance_km": {
                            "type": "number"
                          },
                          "travel_minutes": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": -2147483648,
                            "maximum": 2147483647
                          },
                          "status": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "logs": [
                    {
                      "id": "record-id",
                      "date": "2026-01-01T12:00:00Z",
                      "distance_km": 12.5,
                      "travel_minutes": null,
                      "status": "stored",
                      "created_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
