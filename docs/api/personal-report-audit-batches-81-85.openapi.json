{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Personal Report, Clinical Authorship and Audit Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/reported-incident-records": {
      "get": {
        "operationId": "auth_own_incidents_list",
        "summary": "Read own incidents list",
        "description": "Read own report/authorship/performance metadata only under active explicit bearer and matching non-null tenant. Registered reporter_user_id, rn_id and performed_by_id refer to actor User ID. Every query binds actor User and tenant, excluding null/other owners and null/other tenants. Projections include only id, stored status where registered, and timestamps. Incident descriptions, patient/client/visit/provider IDs, clinical data, scores, recommendations, reconciliation contents, competencies/feedback and technical audit details are excluded. Supervision ownership uses rn_id (User), not provider_id (ProviderProfile); incident acknowledgement does not grant reporter access. Stored status does not establish resolution, medication correctness, competence or audit success. Bounded lists ordered by registered timestamp then id; owned detail absent returns 404. No arbitrary role/owner/tenant filters, clinical writes, business transitions or new grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "incidents",
                    "pagination"
                  ],
                  "properties": {
                    "incidents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "status",
                          "created_at",
                          "updated_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "incidents": [
                    {
                      "id": "record-id",
                      "status": null,
                      "created_at": "2026-01-01T12:00:00Z",
                      "updated_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
