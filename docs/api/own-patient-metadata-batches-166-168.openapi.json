{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Patient-Linked Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/client/alert-records": {
      "get": {
        "operationId": "client_own_patient_alerts_list",
        "summary": "Read owned patient alerts list",
        "description": "Read only own patient-linked alert, insurance-claim or prescription metadata. Active explicit bearer, matching non-null tenant and exactly one actor-owned ClientProfile required. Every data query binds patient_id to that ClientProfile and tenant_id to the actor tenant. Claim provider_id refers to InsuranceProvider and grants no care-provider access. Expose registered IDs, stored statuses, alert type/severity and timestamps only. Exclude alert messages, medications, dosage/frequency/instructions, prescriber/provider identifiers, claim amounts/denials and private clinical contents. Stored statuses are not diagnoses, instructions, coverage approval, payment settlement or permission to act. Bounded lists and exact owned detail, no-store read-only repeatable-read snapshots and source limits. No delegated family access, writes or role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected owned metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "alerts",
                    "pagination"
                  ],
                  "properties": {
                    "alerts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "type",
                          "severity",
                          "status",
                          "created_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "severity": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "alerts": [
                    {
                      "id": "record-id",
                      "type": "stored",
                      "severity": "stored",
                      "status": "stored",
                      "created_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Profile or record absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable"
          }
        }
      }
    },
