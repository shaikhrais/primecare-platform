{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Audit Event Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/audit-event-records": {
      "get": {
        "operationId": "auth_own_audit_logs_list",
        "summary": "Read own audit logs list",
        "description": "Read only your own recorded audit/system event IDs and creation timestamps. Every query binds actor_user_id to the active bearer User and tenant_id to the matching non-null actor tenant. Null/system actors, foreign actors and other tenants are excluded. Actions, resource/model/entity IDs, IP/device identifiers, metadata, payloads, previous data and checksums are excluded. Event timestamps do not prove success, completeness, permission or causality. Bounded list and exact owned detail under read-only repeatable-read snapshots, no-store and source limits. No new grants or mutations.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "pagination"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "created_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "events": [
                    {
                      "id": "record-id",
                      "created_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
    "/v1/auth/me/audit-event-records/{recordId}": {
      "get": {
        "operationId": "auth_own_audit_logs_detail",
        "summary": "Read own audit logs detail",
