{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare API Execution Status",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/governance/api-service-status": {
      "get": {
        "operationId": "governance_api_service_status",
        "summary": "Read recorded operation coverage across 12 gateway services",
        "description": "Existing inventory authority, active explicit bearer session and tenant match required. Recorded governance evidence only. Active/healthy declarations do not prove executable APIs. Unit-tested records do not imply PostgreSQL or production verification. Filters apply to operation records before aggregation; pagination applies to the 12 service groups plus an unassigned group. PRISMA and unknown labels remain unassigned. Zero declarations are not completion evidence. Service labels do not prove deployed routes.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "app",
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          },
          {
            "in": "query",
            "name": "role",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "in": "query",
            "name": "screen",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded API execution status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination",
                    "source"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "service",
                          "gatewayBound",
                          "declaredOperations",
                          "verificationStates",
                          "contractGaps",
                          "unmappedServiceLabels",
                          "evidenceScope",
                          "productionVerified",
                          "postgresVerified"
                        ],
                        "properties": {
                          "service": {
                            "type": "string"
                          },
                          "gatewayBound": {
                            "type": "boolean"
                          },
                          "declaredOperations": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "verificationStates": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "contractGaps": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "unmappedServiceLabels": {
                            "type": "array",
                            "items": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "evidenceScope": {
                            "const": "registered_operation_metadata"
                          },
                          "postgresVerified": {
                            "const": false
                          },
                          "productionVerified": {
                            "const": false
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    },
                    "source": {
                      "type": "object",
                      "required": [
                        "catalogVersion",
                        "evidenceType"
                      ],
                      "properties": {
                        "catalogVersion": {
                          "type": "string"
                        },
                        "evidenceType": {
                          "const": "registered_governance"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "No active session"
          },
          "403": {
            "description": "Inventory authority or tenant mismatch"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
