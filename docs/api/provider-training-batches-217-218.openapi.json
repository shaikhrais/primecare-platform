{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Provider Training Assignment Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/training-assignment-records": {
      "get": {
        "operationId": "provider_own_training_assignments_list",
        "summary": "Read own training assignments list",
        "description": "Read training assignment metadata linked to the unique active actor-owned ProviderProfile. Every query joins provider_profiles and binds profile ID, current actor tenant and actor User. Staff-only, null-provider and foreign-profile assignments are excluded. Project only ID, stored status and assignment/due/completion timestamps; no module contents, staff IDs or certification inference. Current profile ownership scope is distinct from historical tenant or training completion authority. Bounded read-only paging, no-store and source limits; no mutations or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "assignments",
                    "pagination"
                  ],
                  "properties": {
                    "assignments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "status",
                          "assigned_at",
                          "due_date",
                          "completed_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
                          },
                          "status": {
                            "type": "string"
                          },
                          "assigned_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "due_date": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "completed_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "assignments": [
                    {
                      "id": "record-id",
                      "status": "stored",
                      "assigned_at": "2026-01-01T12:00:00Z",
                      "due_date": "2026-01-01T12:00:00Z",
                      "completed_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
    "/v1/provider/training-assignment-records/{recordId}": {
      "get": {
        "operationId": "provider_own_training_assignments_detail",
        "summary": "Read own training assignments detail",
        "description": "Read training assignment metadata linked to the unique active actor-owned ProviderProfile. Every query joins provider_profiles and binds profile ID, current actor tenant and actor User. Staff-only, null-provider and foreign-profile assignments are excluded. Project only ID, stored status and assignment/due/completion timestamps; no module contents, staff IDs or certification inference. Current profile ownership scope is distinct from historical tenant or training completion authority. Bounded read-only paging, no-store and source limits; no mutations or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "recordId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "assignment"
                  ],
                  "properties": {
                    "assignment": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "status",
                        "assigned_at",
                        "due_date",
                        "completed_at"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
                        },
                        "status": {
                          "type": "string"
                        },
                        "assigned_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "due_date": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "completed_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "assignment": {
                    "id": "record-id",
                    "status": "stored",
                    "assigned_at": "2026-01-01T12:00:00Z",
                    "due_date": "2026-01-01T12:00:00Z",
                    "completed_at": "2026-01-01T12:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
    "/v1/provider/training-assignment-records/summary": {
      "get": {
        "operationId": "provider_own_training_assignments_summary",
        "summary": "Read own training assignments summary",
        "description": "Read training assignment metadata linked to the unique active actor-owned ProviderProfile. Every query joins provider_profiles and binds profile ID, current actor tenant and actor User. Staff-only, null-provider and foreign-profile assignments are excluded. Project only ID, stored status and assignment/due/completion timestamps; no module contents, staff IDs or certification inference. Current profile ownership scope is distinct from historical tenant or training completion authority. Bounded read-only paging, no-store and source limits; no mutations or grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "status": "stored",
                      "count": 1
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
