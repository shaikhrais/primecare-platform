{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Owner Status Summaries Batch 14",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/client/bookings/summary": {
      "get": {
        "operationId": "client_own_status_summary",
        "summary": "Own booking status totals",
        "description": "Active explicit bearer session, owned profile and matching tenant required. Queries restrict client_id or assigned_provider_id to that profile and tenant_id to the actor tenant. Groups use stored statuses, including null. No arbitrary owner or date/status filters. Provider durations are recorded sums, not clinical completion or billable time. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status groups with bounded pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count"
                        ],
                        "properties": {
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own profile absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/v1/provider/visits/summary": {
      "get": {
        "operationId": "provider_own_status_summary",
        "summary": "Assigned visit status totals",
        "description": "Active explicit bearer session, owned profile and matching tenant required. Queries restrict client_id or assigned_provider_id to that profile and tenant_id to the actor tenant. Groups use stored statuses, including null. No arbitrary owner or date/status filters. Provider durations are recorded sums, not clinical completion or billable time. No new role grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status groups with bounded pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count",
                          "durationMinutes"
                        ],
                        "properties": {
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "count": {
                            "type": "integer"
                          },
                          "durationMinutes": {
                            "type": "string",
                            "description": "Exact sum of recorded duration_minutes; not billable or completed time."
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/body"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Tenant mismatch"
          },
          "404": {
            "description": "Own profile absent"
          },
          "405": {
            "description": "Unsupported method"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
