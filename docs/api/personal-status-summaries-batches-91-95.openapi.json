{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Personal Owned Status Summaries",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/reported-incident-records/summary": {
      "get": {
        "operationId": "auth_own_incidents_summary",
        "summary": "Read own incidents summary",
        "description": "Count stored statuses for records directly owned by the active bearer actor User, binding the registered author_id, reviewer_id, reviewed_by, reporter_user_id or rn_id and matching non-null tenant in every query. Other users, null owners and other/null tenants are excluded. Nullable stored statuses remain a null group; no normalization or inferred outcome. Pagination total counts status groups, not records. No clinical contents, patient IDs, provider IDs, review/payroll details or incident/medication contents. Counts do not establish review approval, completed care, incident resolution, medication correctness or payroll eligibility. Bounded pagination and no-store repeatable-read responses; no arbitrary ownership/tenant filters, business writes or permission grants.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "pagination"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "count"
                        ],
                        "properties": {
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "maxItems": 100
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "groups": [
                    {
                      "status": null,
                      "count": 1
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
