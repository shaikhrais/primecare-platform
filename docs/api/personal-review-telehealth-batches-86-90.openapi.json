{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Personal Authorship, Review and Telehealth Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/authored-care-plan-records": {
      "get": {
        "operationId": "auth_own_care_plans_list",
        "summary": "Read own care plans list",
        "description": "Read own authored/reviewed/provider-session metadata under active explicit bearer and matching non-null tenant. Registered author_id, reviewer_id, reviewed_by and telehealth_sessions.provider_id refer to actor User ID. Every query binds actor User and tenant, excluding null/foreign ownership and tenants. Timesheets/performance_reviews.provider_id instead refers to ProviderProfile and is not used for reviewer ownership. Clinical contents, patient IDs, reviewed provider IDs, ratings/goals/notes, payroll totals and meeting links are excluded. Stored statuses/times are not evidence of review approval, completed care, session attendance or payroll eligibility. Lists are bounded and ordered by created_at then id; summary total counts status groups. No clinical writes, role grants, approval/join actions or arbitrary owner/tenant filters.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "plans",
                    "pagination"
                  ],
                  "properties": {
                    "plans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "status",
                          "created_at",
                          "updated_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "plans": [
                    {
                      "id": "record-id",
                      "status": "stored",
                      "created_at": "2026-01-01T12:00:00Z",
                      "updated_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
