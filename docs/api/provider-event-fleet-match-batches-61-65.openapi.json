{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Own Visit Events, Fleet Status and Match Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/provider/visit-check-events": {
      "get": {
        "operationId": "provider_own_visit_check_events_list",
        "summary": "Read own visit check events list",
        "description": "Active explicit bearer, matching non-null tenant and exactly one actor-owned provider profile required. Tenant-scoped event/match queries bind provider_id and tenant_id; fleet records lack tenant_id and join the current owning provider profile, binding profile ID, tenant and actor user ID on every query. Events expose stored type/result/timestamps, not proof of attendance. Fleet exposes stored status/battery/heartbeat, not guaranteed current availability or verified location. Matches expose metadata only; status does not grant assignment or patient access. GPS, visit IDs, raw telemetry, overrides/rejection reasons, match scores and client identifiers are excluded. Reads do not change state. Summaries count stored groups. No grants or writes.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "pagination"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "event_type",
                          "result",
                          "device_time_iso",
                          "server_time",
                          "created_at"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "event_type": {
                            "type": "string"
                          },
                          "result": {
                            "type": "string"
                          },
                          "device_time_iso": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "server_time": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "events": [
                    {
                      "id": "record-id",
                      "event_type": "stored",
                      "result": "stored",
                      "device_time_iso": "2026-01-01T12:00:00Z",
                      "server_time": "2026-01-01T12:00:00Z",
                      "created_at": "2026-01-01T12:00:00Z"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
