{
  "openapi": "3.1.0",
  "info": {
    "title": "PrimeCare Personal Work-Log Metadata",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/me/shift-logs": {
      "get": {
        "operationId": "auth_own_provider_shift_logs_list",
        "summary": "Read own provider shift logs list",
        "description": "Active explicit bearer and matching non-null tenant required. Every query binds the actor User ID and tenant: provider_shift_logs.provider_id and adl_care_logs.provider_id refer to User; daily_entries.staff_id refers to User. Clinical contents, patient/client/visit IDs, GPS and signatures are excluded. Stored shift/status labels do not confirm completed care, attendance, payroll or clinical correctness. Direct authorship grants metadata access only, without patient-record access or clinical writes. Lists use bounded paging and registered timestamp order; summaries count stored groups. No new grants or mutations.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected own records or status groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "logs",
                    "pagination"
                  ],
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "date",
                          "start_time",
                          "end_time",
                          "shiftStatus"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"
                          },
                          "date": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "start_time": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "end_time": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "shiftStatus": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit",
                        "offset",
                        "total",
                        "hasMore"
                      ],
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "logs": [
                    {
                      "id": "record-id",
                      "date": "2026-01-01T12:00:00Z",
                      "start_time": "2026-01-01T12:00:00Z",
                      "end_time": "2026-01-01T12:00:00Z",
                      "shiftStatus": "stored"
                    }
                  ],
                  "pagination": {
                    "limit": 25,
                    "offset": 0,
                    "total": 1,
                    "hasMore": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/query/body"
          },
          "401": {
            "description": "No active bearer session"
          },
          "403": {
            "description": "Tenant mismatch or missing actor tenant"
          },
          "404": {
            "description": "Owned record/profile absent"
          },
          "405": {
            "description": "Read only"
          },
          "429": {
            "description": "Source limit"
          },
          "503": {
            "description": "Data unavailable or ambiguous profile"
          }
        }
      }
    },
