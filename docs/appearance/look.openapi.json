    "/v1/governance/look/reviews/{id}/human": {
      "post": {
        "operationId": "look_post_reviews_id_human",
        "summary": "/reviews/{id}/human",
        "description": "Active explicit bearer session and governed administrator grants. Global central/platform scope; CEO/tenant administrator own-tenant scope. Scores come only from the trusted server binding. AI never performs final human approval. No production-readiness credits.",
        "security": [
