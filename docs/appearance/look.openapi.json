                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "decision": {
                    "enum": [
                      "approve",
                      "request_changes",
                      "reject"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "imageDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reviewed": {
                    "const": true
                  }
                },
                "required": [
