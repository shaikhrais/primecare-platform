          "413": {
            "description": "Body/image too large"
          },
          "415": {
            "description": "JSON required"
          },
          "429": {
            "description": "Actor/model limit"
          },
          "503": {
            "description": "Provider/configuration/database/audit unavailable"
          }
        }
      }
    },
