{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:primecare:proposal:dashboard-preferences:v1:shared",
  "$comment": "Draft only: not registered, imported by runtime, or activated. Structural constraints do not grant authority.",
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "userId",
        "role",
        "dataset"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "dataset": {
          "enum": [
            "live",
            "demo"
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "views"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "views": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!constructor$|prototype$)[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "span",
                "rows"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(?!constructor$|prototype$)[a-z][a-z0-9-]{0,63}$"
                },
                "span": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            }
          }
        }
      }
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
